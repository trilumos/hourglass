---
// Home (landing hero). The SCENE renders the current LOCAL-time plate + the hourglass sand looping at ~40%
// (falling continuously, never filling). The Home (locked hero-v22) sits over it. Setup + Session next.
import SceneWorld from '../components/SceneWorld.astro';
import Home from '../components/Home.astro';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Sustain — a calm focus timer inside a living seaside world." />
    <title>Sustain — a calm focus timer</title>
    <!-- v22 type stack (dev via Google Fonts; self-host in the perf pass — spec §13/§18). -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;1,300;1,400&family=Newsreader:ital,opsz,wght@1,6..72,200..500&family=Jost:wght@200;300;400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <SceneWorld />
    <Home />
  </body>
</html>
