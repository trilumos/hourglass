---
// Home (landing hero). Background is STATIC day-time plates that crossfade the day (sun/moon) on scroll —
// NOT the live WebGL scene (that's the Session). Setup + Session states get layered next.
import Home from '../components/Home.astro';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Sustain — a calm focus timer inside a living seaside world." />
    <title>Sustain — a calm focus timer</title>
    <!-- v22 type stack (dev via Google Fonts; self-host in the perf pass — spec §13/§18). -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;1,300;1,400&family=Newsreader:ital,opsz,wght@1,6..72,200..500&family=Jost:wght@200;300;400;500&display=swap"
      rel="stylesheet"
    />
    <style is:global>
      * { margin:0; padding:0; box-sizing:border-box; }
      html { scroll-behavior:auto; }
      body { min-height:100%; background:#0a1a2a; font-family:Jost, ui-sans-serif, system-ui, sans-serif;
             -webkit-font-smoothing:antialiased; }
    </style>
  </head>
  <body>
    <Home />
  </body>
</html>
