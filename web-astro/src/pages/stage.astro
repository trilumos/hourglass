        }
        // Restores geometry only — never text, which must follow the session that is being recorded.
        function thLoadLayout(){
          var d; try { d = JSON.parse(localStorage.getItem(TH_KEY) || 'null'); } catch (e){}
          if (!d) return;
          if (d.top) { TH.top.x = d.top.x; TH.top.y = d.top.y; TH.top.size = d.top.size; }
          if (d.l2r != null) TH.l2r = d.l2r;
          if (d.occ != null) TH.occ = d.occ;
          if (d.bot) { TH.bot.y = d.bot.y; TH.bot.size = d.bot.size;
                       TH.bot.gapL = d.bot.gapL; TH.bot.gapR = d.bot.gapR;
                       TH.bot.sep = d.bot.sep; TH.bot.even = d.bot.even; }
          if (d.lock){ TH.lock.top = !!d.lock.top; TH.lock.bot = !!d.lock.bot; }
          if (d.snd){                       // recreate the row, then put it back where it was
            thSoundRow();
            var b = thSndBox();
            if (b){ b.y = d.snd.y; b.size = d.snd.size;
                    if (d.snd.x != null) b.x = d.snd.x;
                    if (d.snd.alpha != null) b.alpha = d.snd.alpha;
                    if (d.snd.spread != null) b.spread = d.snd.spread;
                    b.lock = !!d.snd.lock; }
          }
          markSepSeg(); thLockUI();
        }
        // Keep the divider/width buttons showing what was actually restored.
        function markSepSeg(){
          Array.prototype.forEach.call(document.querySelectorAll('.th-seg [data-sep]'), function(b){
            b.classList.toggle('on', b.dataset.sep === TH.bot.sep); });
          if ($t('thEven')) $t('thEven').classList.toggle('on', !!TH.bot.even);
          if ($t('thNatural')) $t('thNatural').classList.toggle('on', !TH.bot.even);
        }
        function thOpen(){
          _thQuiet++;
          thDefaults();            // text from the session config
          thLoadLayout();          // geometry from last time — never text
          _thQuiet--;
          thExtraUI(); thSync();
          document.documentElement.classList.add('thumb-open');
          (document.fonts ? document.fonts.ready : Promise.resolve()).then(function(){ thDraw(); });
        }
        function thClose(){
          document.documentElement.classList.remove('thumb-open');
          cancelAnimationFrame(thRAF);
        }
        // Drag whichever block you grabbed; wheel resizes it.
        var thDragging = null, thGuide = true;
        // Which handle did you grab? Top block owns the upper ~2/3; below that, whichever SIDE of the
        // hourglass axis you clicked — so the two bottom words drag independently.
        // Pointer -> frame fractions. The canvas is CSS-scaled, so always go through the rect.
        function thPt(e){
          var r = thCv.getBoundingClientRect();
          return { x:(e.clientX - r.left) / r.width, y:(e.clientY - r.top) / r.height };
        }
        // Grab the NEAREST handle, not whatever a y-threshold guesses. A single dividing line was
        // fragile — anything that moved the bottom row near it, or any CSS scaling of the canvas, made
        // every click resolve to the heading. Distance to the real anchor always picks what you aimed at.
        // Only FREE boxes are grabbable. The heading and the bottom pair are the series template —
        // the thing that makes 90 thumbnails read as one channel — and a stray drag on either is
        // invisible at 1280 wide, surfacing only as drift once the videos sit side by side on the
        // channel page. Their sliders still set them deliberately; the pointer cannot nudge them.
        // (Replaces a nearest-anchor scheme that had no knowledge of free boxes at all, which is the
        // real reason the sound row could never be dragged.)
        // One place decides whether a box can move, so drag, wheel and the border style can
        // never disagree about it.
        function thLocked(r){
          return r.kind === 'extra' ? !!(TH.extra[r.i] && TH.extra[r.i].lock) : !!TH.lock[r.kind];
        }
        function thHit(e){
          var p = thPt(e), rs = thRects();
          for (var j = rs.length - 1; j >= 0; j--){          // last drawn sits on top
            var r = rs[j];
            if (thLocked(r)) continue;
            if (Math.abs(p.x - r.x) <= r.w/2 && Math.abs(p.y - r.y) <= r.h/2) return r;
          }
          return null;
        }
        var thHover = null;
        thCv.addEventListener('pointerdown', function(e){
          var h = thHit(e); if (!h) return;                 // nothing grabbable there
          thDragging = h; thCv.setPointerCapture(e.pointerId);
        });
        thCv.addEventListener('pointermove', function(e){ if (!thDragging) thHover = thHit(e); });
        thCv.addEventListener('pointerleave', function(){ thHover = null; });
        thCv.addEventListener('pointermove', function(e){
          if (!thDragging) return;
          var p = thPt(e);
          var nx = Math.max(0.02, Math.min(0.98, p.x));
          var ny = Math.max(0.04, Math.min(0.97, p.y));
          var ax = thAxis();
          if (thDragging.kind === 'extra'){
            var b = TH.extra[thDragging.i];
            if (b){ if (Math.abs(nx - ax) < 0.012) nx = ax; b.x = nx; b.y = ny; }
          } else if (thDragging.kind === 'top'){
            if (Math.abs(nx - ax) < 0.012) nx = ax;    // snap to the glass centreline
            TH.top.x = nx; TH.top.y = ny - thDrop();   // store the base, not the dropped position
          } else {
            // Horizontal drag becomes that side's OWN gap; vertical is shared so the row stays level.
            if (thDragging.side === 'L') TH.bot.gapL = Math.max(0, ax - nx);
            else                         TH.bot.gapR = Math.max(0, nx - ax);
            TH.bot.y = ny; thSync();
          }
        });
        addEventListener('pointerup', function(){
          if (thDragging) thSaveLayout();       // drags move geometry without touching a slider
          thDragging = null;
        });
        thCv.addEventListener('wheel', function(e){
          e.preventDefault();
          var h = thHit(e); if (!h) return;                 // locked blocks ignore the wheel
          var k = e.deltaY < 0 ? 1.06 : 1/1.06;
          var b = h.kind === 'extra' ? TH.extra[h.i] : h.kind === 'top' ? TH.top : TH.bot;
          if (!b) return;
          b.size = Math.max(0.015, Math.min(0.30, b.size * k));
          thSync();
        }, { passive:false });

        // Sliders, not just the scroll wheel: a NUMBER is what keeps 90 thumbnails identical, and the
        // readout is the thing you copy to the next video.
        function thSync(){
          thSaveLayout();
          $t('thTopSize').value = Math.round(TH.top.size*1000);  $t('thTopVal').textContent = Math.round(TH.top.size*1000);
          $t('thL2Size').value  = Math.round(TH.l2r*100);        $t('thL2Val').textContent  = Math.round(TH.l2r*100);
          $t('thOcc').value     = Math.round(TH.occ*100);        $t('thOccVal').textContent = Math.round(TH.occ*100) + '%';
          $t('thBotSize').value = Math.round(TH.bot.size*1000);  $t('thBotVal').textContent = Math.round(TH.bot.size*1000);
          $t('thGapL').value = Math.round(TH.bot.gapL*1000); $t('thGapLVal').textContent = Math.round(TH.bot.gapL*1000);
          var _sb = thSndBox();
          $t('thSndSize').value = Math.round((_sb ? _sb.size : TH.bot.size*0.75)*1000);
          $t('thSndVal').textContent = _sb ? Math.round(_sb.size*1000) : '—';
          $t('thSndSpread').value = _sb ? (_sb.spread || 0) : 0;
          $t('thSndSprVal').textContent = _sb ? Math.round(_sb.spread || 0) : '—';
          $t('thGapR').value = Math.round(TH.bot.gapR*1000); $t('thGapRVal').textContent = Math.round(TH.bot.gapR*1000);
        }
        [[thL1,'l1'],[thL2,'l2'],[thBL,'bl'],[thBR,'br']].forEach(function(p){
          p[0].addEventListener('input', function(){ TH[p[1]] = p[0].value; thCheck(); });
        });
        // A new box lands in clear space below the heading, carrying the next unused config string —
        // "add text" that makes you then type the thing the app already knows is just friction.
        function thAddBox(){
          var pool = thPool(), used = TH.extra.map(function(b){ return b.text; })
            .concat([TH.l1, TH.l2, TH.bl, TH.br]);
          var text = pool.filter(function(t){ return used.indexOf(t) < 0; })[0] || 'TEXT';
          TH.extra.push({ text:text, x:thAxis(), y:0.72 + TH.extra.length*0.07, size:TH.bot.size });
          thExtraUI();
        }
        // The sound row is the one extra box every video in the series wants, so it gets a preset
        // rather than four manual adjustments. Placed on the hourglass axis like the bottom pair,
        // sized at 75% of it and slightly dimmed: mode and time are the video's identity, the sound
        // is the variant, and equal weight would have the two rows competing.
        // Re-clicking updates the existing row instead of stacking duplicates — the sound changes far
        // more often than the layout does.
        function thSoundRow(){
          var size = TH.bot.size * 0.75;
          // Sit it below the pair, but never let the box run off the bottom of the frame.
          var y = Math.min(TH.bot.y + TH.bot.size * 1.35, 0.975 - size * 0.85);
          var box = TH.extra.filter(function(b){ return b.role === 'sound'; })[0];
          var isNew = !box; if (isNew) box = {};
          box.role = 'sound'; box.text = thSoundLabel(readCfg());
          if (isNew){ box.x = thAxis(); box.y = y; box.size = size; box.alpha = 0.85;
                      thSeedSpread(box); TH.extra.push(box); }
          // Re-clicking refreshes the TEXT for the new session but leaves the geometry you set alone.
          thExtraUI();
        }
        $t('thSndRow').addEventListener('click', thSoundRow);
        function thLockUI(){
          $t('thLockTop').classList.toggle('on', !!TH.lock.top);
          $t('thLockTop').textContent = TH.lock.top ? 'Heading LOCKED' : 'Heading unlocked';
          $t('thLockBot').classList.toggle('on', !!TH.lock.bot);
          $t('thLockBot').textContent = TH.lock.bot ? 'Bottom row LOCKED' : 'Bottom row unlocked';
        }
        $t('thLockTop').addEventListener('click', function(){
          TH.lock.top = !TH.lock.top; thLockUI(); thSaveLayout(); });
        $t('thLockBot').addEventListener('click', function(){
          TH.lock.bot = !TH.lock.bot; thLockUI(); thSaveLayout(); });
        function thSndBox(){ return TH.extra.filter(function(b){ return b.role === 'sound'; })[0]; }
        $t('thSndSize').addEventListener('input', function(){
          var b = thSndBox(); if (!b) return;
          b.size = +this.value / 1000; thSync();
        });
        $t('thSndSpread').addEventListener('input', function(){
          var b = thSndBox(); if (!b) return;
          b.spread = +this.value; thSync();
        });
        function thExtraUI(){
          var wrap = $t('thExtra');
          wrap.innerHTML = TH.extra.map(function(b, i){
            return '<div class="th-xrow"><button data-lock="' + i + '">'
                 + (b.lock ? 'LOCKED' : 'unlocked') + '</button>'
                 + '<input type="text" maxlength="28" data-i="' + i + '" value="'
                 + String(b.text).replace(/"/g, '&quot;') + '"><button data-del="' + i + '">✕</button></div>';
          }).join('');
          thCheck();
        }
        // The one thumbnail rule with the most evidence behind it: three words, five at the absolute
        // outside. Easy to break the moment free text boxes exist, and invisible at 1280 wide — you
        // only find out in the feed. So it is checked here rather than discovered later.
        function thCheck(){
          var words = [TH.l1, TH.l2, TH.bl, TH.br]
            .concat(TH.extra.map(function(b){ return b.text; }))
            .join(' ').trim().split(/\s+/).filter(Boolean).length;
          var el = $t('thWarn');
          el.textContent = words > 5
            ? words + ' words. Three is the rule, five is the ceiling — this will not read at 320×180.'
            : words > 3 ? words + ' words. Three reads best in a feed.' : '';
        }
        $t('thAdd').addEventListener('click', thAddBox);
        $t('thExtra').addEventListener('input', function(e){
          var i = e.target.dataset.i; if (i == null) return;
          TH.extra[+i].text = e.target.value; thCheck();
        });
        $t('thExtra').addEventListener('click', function(e){
          var lk = e.target.dataset.lock;
          if (lk != null){ TH.extra[+lk].lock = !TH.extra[+lk].lock; thExtraUI(); thSaveLayout(); return; }
          var d = e.target.dataset.del; if (d == null) return;
          TH.extra.splice(+d, 1); thExtraUI(); thSaveLayout();
        });
        function rng(id, set){ $t(id).addEventListener('input', function(){ set(+this.value); thSync(); }); }
        rng('thTopSize', function(v){ TH.top.size = v/1000; });
        rng('thL2Size',  function(v){ TH.l2r = v/100; });
        rng('thOcc',     function(v){ TH.occ = v/100; });
        rng('thBotSize', function(v){ TH.bot.size = v/1000; });
        rng('thGapL',    function(v){ TH.bot.gapL = v/1000; });
        rng('thGapR',    function(v){ TH.bot.gapR = v/1000; });
        Array.prototype.forEach.call(document.querySelectorAll('.th-seg button'), function(b){
          b.addEventListener('click', function(){
            TH.bot.sep = b.dataset.sep;
            Array.prototype.forEach.call(document.querySelectorAll('.th-seg button'), function(x){ x.classList.toggle('on', x===b); });
          });
        });
        (function(){
          var be = $t('thEven'), bn = $t('thNatural');
          var set = function(v){ TH.bot.even = v; be.classList.toggle('on', v); bn.classList.toggle('on', !v); };
          be.addEventListener('click', function(){ set(true); });
          bn.addEventListener('click', function(){ set(false); });
        })();
        document.getElementById('thumbReset').addEventListener('click', function(){
          TH.top = { x:0.5, y:0.20, size:0.135 }; TH.l2r = 0.52; TH.occ = 1;
          TH.bot = { y:0.90, size:0.045, gapL:0.115, gapR:0.115, sep:TH.bot.sep, even:TH.bot.even };
          thDefaults();
        });
        document.getElementById('thumbClose').addEventListener('click', thClose);
        document.getElementById('thumbSave').addEventListener('click', function(){
          thGuide = false;
          var f = SustainScene.thumbFrame({ w:1280, h:720, paint:thPaint, paintOver:thPaintOver, occAlpha:TH.occ });
          thGuide = true;
          f.toBlob(function(b){
            var c = readCfg(), name = 'thumb_' + (c.mode||'x') + '_' + (c.totalMin||0) + 'm_'
                  + lightLabel(c).toLowerCase().replace(/\s+/g,'-') + '.png';
            var a = document.createElement('a');
            a.href = URL.createObjectURL(b); a.download = name; a.click();
            setTimeout(function(){ URL.revokeObjectURL(a.href); }, 4000);
          }, 'image/png');
        });
        addEventListener('keydown', function(e){
          if (e.key === 'Escape' && document.documentElement.classList.contains('thumb-open')){
            e.preventDefault(); e.stopPropagation(); thClose();
          }
        }, true);

        // Inject the trigger beside Begin — Setup.astro is shared with the public site and stays untouched.
        (function(){
          var b = document.createElement('button');
          b.id = 'thumbBtn'; b.type = 'button'; b.textContent = 'Thumbnail';
          b.addEventListener('click', thOpen);
          document.body.appendChild(b);
        })();
      })();
    </script>
  </body>
</html>
