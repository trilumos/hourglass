---
// /stage — the STUDIO (master spec §18.7, first-push §4.4, strategy §10).
//
// The SAME app, minus the session chrome. You configure a session on the REAL Setup screen (identical to
// production: mode, durations, intention, sounds + mixer, theme / time-of-day, number look), press Begin,
// and the session then runs with NO UI at all: no pause/resume, no break button, no settings gear, no give
// up, no popcards, no navigation guard. It simply follows the config to the end and fades to black.
// Browser Back (or a back swipe) is the way out.
//
// It is pointed at by OBS **Browser Source** — never Window/Display Capture, which screen-scrapes a
// throttled background tab (strategy §10 names that as the cause of the freeze/black-screen glitch).
// Setup guide: docs/obs-stage-streaming-guide.md
//
// "The site is the studio. We do not build a second render engine." — every screen here is the real one.
//
// ?record=1  capture preset: hides the cursor and stops the breathing zoom.
//
// noindex: a capture surface, not a page for humans.
import SceneWorld from '../components/SceneWorld.astro';
import Setup from '../components/Setup.astro';
import Session from '../components/Session.astro';
import { LQIP } from '../scene/lqip.js';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Sustain — Stage</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" href="/favicon-round.png" type="image/png" />
    <script is:inline>
      // Must run BEFORE the component modules: Session reads this class to skip the navigation guard.
      document.documentElement.classList.add('stage');
      if (/[?&]record=1\b/.test(location.search)) document.documentElement.classList.add('rec');
      if (!location.hash) location.replace('#setup');
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,600;1,500&family=Newsreader:ital,opsz,wght@0,6..72,400..600;1,6..72,200..500&family=Jost:wght@200..600&display=swap"
      rel="stylesheet"
    />
    <style is:global>
      @font-face{ font-family:'NumSerif'; font-weight:550; font-display:swap; src:url('/assets/fonts/newsreader-550.woff2') format('woff2'); }
      @font-face{ font-family:'NumSans';  font-weight:550; font-display:swap; src:url('/assets/fonts/jost-550.woff2') format('woff2'); }

      /* The stage never scrolls. */
      :root.stage, :root.stage body { height:100%; overflow:hidden; }

      /* ── the whole point: a session with NO interface ──────────────────────────────────────────────
         Everything the user would touch during a session is removed. The engine still drives breaks,
         segment advances and completion exactly as in production; only the controls are gone. */
      :root.stage #gear,
      :root.stage #giveup,
      :root.stage #pause,
      :root.stage #breakBtn,
      :root.stage #intentTop,
      :root.stage #seglabel,
      :root.stage #giveupConfirm,
      :root.stage #doneCard,
      :root.stage #sessionOver,
      :root.stage #paused,
      :root.stage #endBreakBtn,
      :root.stage #numEditToggle,
      :root.stage #numEditor,
      /* by ID, NOT by .sheet/.sheet-scrim: Setup's Advanced sheet uses those same class names, so a class
         selector here silently killed Advanced settings on the stage's Setup screen too */
      :root.stage #setSheet,
      :root.stage #setScrim { display:none !important; }

      /* capture preset */
      :root.rec { cursor:none; }
      :root.rec #frame { animation:none !important; }

      /* ── 3-2-1 lead-in. The session is paused underneath, so the recording has time to spin up and the
            first counted second is still on tape. ──────────────────────────────────────────────────── */
      :root.stage-count #frame{ filter:blur(12px) saturate(.95); }
      #stageCount{ position:fixed; inset:0; z-index:98; display:none;
        align-items:center; justify-content:center; pointer-events:none;
        background:rgba(6,11,26,.34); }
      :root.stage-count #stageCount{ display:flex; }
      #stageCount b{ font-family:'NumSerif', Georgia, serif; font-weight:550; color:#fffaf0;
        font-size:min(28vh, 34vw); line-height:1; letter-spacing:-.02em;
        text-shadow:0 2px 40px rgba(0,0,0,.35); }
      @keyframes countPulse{ from{ opacity:0; transform:scale(1.12) } 22%{ opacity:1; transform:none } to{ opacity:.85; transform:none } }
      #stageCount b{ animation:countPulse .9s cubic-bezier(.16,1,.3,1); }

      /* ── the session ends → fade to black. Back / back-swipe is the way out. ─────────────────────── */
      #stageEnd{ position:fixed; inset:0; z-index:99; background:#000; opacity:0; pointer-events:none;
        transition:opacity 2.4s cubic-bezier(.4,0,.2,1); }
      :root.stage-done #stageEnd{ opacity:1; pointer-events:auto; }
    </style>
  </head>
  <body>
    <div id="lqip"></div>
    <script is:inline define:vars={{ LQIP }}>
      // Same blur-up as the app so a capture never opens on a black frame.
      (function () {
        var h = new Date().getHours() + new Date().getMinutes() / 60;
        var i = h < 4.9 ? 5 : h < 6.1 ? 0 : h < 8.4 ? 1 : h < 18.2 ? 2 : h < 19.65 ? 3 : h < 21.75 ? 4 : 5;
        var el = document.getElementById('lqip');
        if (el && LQIP[i]) el.style.backgroundImage = 'url(' + LQIP[i] + ')';
        var names = ['pre-dawn', 'sunrise', 'midday', 'sunset', 'twilight', 'midnight'];
        var l = document.createElement('link');
        l.rel = 'preload'; l.as = 'image'; l.href = '/plates-phases/' + names[i] + '.webp';
        l.setAttribute('fetchpriority', 'high');       // no crossorigin — see index.astro
        document.head.appendChild(l);
      })();
    </script>

    <SceneWorld />
    <Setup />
    <Session />
    <div id="stageCount" aria-hidden="true"><b id="stageCountN">3</b></div>
    <div id="stageEnd" aria-hidden="true"></div>

    <script is:inline>
      // A two-state router: Setup ⇄ Session. Setup and Session each own their own behaviour off the hash;
      // this only does what index.astro's controller does for the app — toggle Setup's visibility and the
      // scene's glass blur — minus Home, the landing story and the scroll machinery.
      (function () {
        var root  = document.documentElement;
        var setup = document.getElementById('setupScreen');

        function sync(){
          var onSetup = location.hash !== '#session';
          if (setup){
            setup.classList.toggle('on', onSetup);
            setup.setAttribute('aria-hidden', onSetup ? 'false' : 'true');
          }
          root.classList.toggle('setup-active', onSetup);
          if (onSetup) root.classList.remove('stage-done');     // going back re-arms the stage
        }
        sync();
        addEventListener('hashchange', sync);

        // ── 3-2-1 lead-in ────────────────────────────────────────────────────────────────────────────
        // Session's own hashchange runs first (its inline script is earlier in the document), so by the
        // time we get here the engine has started. We immediately PAUSE it and count 3-2-1 over a blurred
        // scene, then resume. The engine is wall-clock based and subtracts paused time, so the block still
        // runs its exact configured length — and the first counted second is safely inside the recording
        // even if OBS took a moment to start.
        var counting = false;
        function leadIn(){
          if (counting) return;
          counting = true;
          root.classList.add('stage-count');
          var n = 3, el = document.getElementById('stageCountN');
          if (el) el.textContent = String(n);

          // Wait for the engine to actually be running, then park it at ZERO elapsed and frozen, so the
          // numerals read the full block length (25:00, not 24:59) for the whole countdown.
          var armed = false, tries = 0;
          var wait = setInterval(function () {
            var S = window.SustainScene;
            var r = S && S.sampleSession && S.sampleSession();
            if (!(r && r.kind && r.kind !== 'idle')) { if (++tries > 60) clearInterval(wait); return; }
            clearInterval(wait);
            try { if (S && S.restartSession){ S.restartSession(true); armed = true; } } catch (e) {}
          }, 50);

          var tick = setInterval(function () {
            n -= 1;
            if (n > 0) {
              if (el){ el.textContent = String(n); el.style.animation = 'none'; void el.offsetWidth; el.style.animation = ''; }
              return;
            }
            clearInterval(tick); clearInterval(wait);
            root.classList.remove('stage-count');
            counting = false;
            try {
              var S = window.SustainScene;
              // Restart from zero rather than resume, so the block begins at exactly its full length.
              if (armed && S && S.restartSession) S.restartSession(false);
              // ...and ring the start bell on the same beat the clock starts.
              if (window.SustainAudio && window.SustainAudio.cue) window.SustainAudio.cue();
            } catch (e) {}
          }, 1000);
        }
        addEventListener('hashchange', function(){
          if (location.hash === '#session') leadIn();
          else { root.classList.remove('stage-count'); counting = false; }
        });

        // Begin → fullscreen. requestFullscreen needs a user gesture, so it hangs off the Begin CLICK
        // rather than the hashchange (which fires in a later task and can lose the activation).
        function goFull(){
          try {
            var el = document.documentElement;
            if (!document.fullscreenElement && el.requestFullscreen) el.requestFullscreen().catch(function(){});
          } catch (e) {}                                     // inside an OBS Browser Source this is a no-op
        }
        var beginBtn = document.getElementById('begin');
        if (beginBtn) beginBtn.addEventListener('click', function () {
          goFull();
          // ...and roll. Same OBS Browser Source API as the auto-stop; a no-op in a normal browser, and it
          // needs the source's Page permissions set to ALL. Guarded on getStatus so pressing Begin twice
          // cannot start a second recording.
          try {
            var obs = window.obsstudio;
            if (!obs || typeof obs.startRecording !== 'function') return;
            if (typeof obs.getStatus === 'function') {
              obs.getStatus(function (st) { if (!st || !st.recording) obs.startRecording(); });
            } else {
              obs.startRecording();
            }
          } catch (e) {}
        });
        // If Esc drops out of fullscreen mid-session, the next interaction puts it back (a gesture is the
        // only thing the browser will accept).
        addEventListener('pointerdown', function(){ if (location.hash === '#session') goFull(); });
        addEventListener('keydown', function(){ if (location.hash === '#session') goFull(); });

        // Completion → fade to black, then tell OBS to stop.
        // window.obsstudio is injected ONLY inside an OBS Browser Source, so this is a no-op in a normal
        // browser. It needs the source's "Page permissions" set to ALL (Advanced access), otherwise the
        // control functions are not exposed. We wait for the 2.4s fade to finish so the recording always
        // ends on clean black, and we only ever fire once.
        var done = false;
        setInterval(function () {
          if (done || location.hash !== '#session' || !window.SustainScene || !SustainScene.sampleSession) return;
          var r = SustainScene.sampleSession();
          if (!r || !r.done) return;
          done = true;
          root.classList.add('stage-done');
          setTimeout(function () {
            try {
              var obs = window.obsstudio;
              if (obs && typeof obs.stopRecording === 'function') obs.stopRecording();
              if (obs && typeof obs.stopStreaming === 'function' && /[?&]stopstream=1\b/.test(location.search)) obs.stopStreaming();
            } catch (e) {}
          }, 3200);
        }, 1000);
      })();
    </script>
  </body>
</html>
