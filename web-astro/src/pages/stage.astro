---
// /stage — the STUDIO (master spec §18.7, first-push §4.4, strategy §10).
//
// The SAME app, minus the session chrome. You configure a session on the REAL Setup screen (identical to
// production: mode, durations, intention, sounds + mixer, theme / time-of-day, number look), press Begin,
// and the session then runs with NO UI at all: no pause/resume, no break button, no settings gear, no give
// up, no popcards, no navigation guard. It simply follows the config to the end and fades to black.
// Browser Back (or a back swipe) is the way out.
//
// It is pointed at by OBS **Browser Source** — never Window/Display Capture, which screen-scrapes a
// throttled background tab (strategy §10 names that as the cause of the freeze/black-screen glitch).
// Setup guide: docs/obs-stage-streaming-guide.md
//
// "The site is the studio. We do not build a second render engine." — every screen here is the real one.
//
// ?record=1  capture preset: hides the cursor and stops the breathing zoom.
//
// noindex: a capture surface, not a page for humans.
import SceneWorld from '../components/SceneWorld.astro';
import Setup from '../components/Setup.astro';
import Session from '../components/Session.astro';
import { LQIP } from '../scene/lqip.js';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Sustain — Stage</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" href="/favicon-round.png" type="image/png" />
    <script is:inline>
      // Must run BEFORE the component modules: Session reads this class to skip the navigation guard.
      document.documentElement.classList.add('stage');
      if (/[?&]record=1\b/.test(location.search)) document.documentElement.classList.add('rec');
      // ALWAYS start on Setup. The hash survives a reload, so `if (!location.hash)` meant that
      // refreshing mid-session simply re-entered the session — leaving no way out of a stuck take
      // inside OBS's chrome-less Interact window.
      if (location.hash !== '#setup') location.replace('#setup');
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,600;1,500&family=Newsreader:ital,opsz,wght@0,6..72,400..600;1,6..72,200..500&family=Jost:wght@200..600&display=swap"
      rel="stylesheet"
    />
    <style is:global>
      @font-face{ font-family:'NumSerif'; font-weight:550; font-display:swap; src:url('/assets/fonts/newsreader-550.woff2') format('woff2'); }
      @font-face{ font-family:'NumSans';  font-weight:550; font-display:swap; src:url('/assets/fonts/jost-550.woff2') format('woff2'); }

      /* The stage never scrolls. */
      :root.stage, :root.stage body { height:100%; overflow:hidden; }

      /* ── the whole point: a session with NO interface ──────────────────────────────────────────────
         Everything the user would touch during a session is removed. The engine still drives breaks,
         segment advances and completion exactly as in production; only the controls are gone. */
      :root.stage #gear,
      :root.stage #giveup,
      :root.stage #pause,
      :root.stage #breakBtn,
      :root.stage #intentTop,
      :root.stage #seglabel,
      :root.stage #giveupConfirm,
      :root.stage #doneCard,
      :root.stage #sessionOver,
      :root.stage #paused,
      :root.stage #endBreakBtn,
      :root.stage #numEditToggle,
      :root.stage #numEditor,
      /* by ID, NOT by .sheet/.sheet-scrim: Setup's Advanced sheet uses those same class names, so a class
         selector here silently killed Advanced settings on the stage's Setup screen too */
      :root.stage #setSheet,
      :root.stage #setScrim { display:none !important; }

      /* capture preset */
      :root.rec { cursor:none; }
      :root.rec #frame { animation:none !important; }

      /* ── The stage is the whole edit ──────────────────────────────────────────────────────────────
         Begin → recording starts → INTRO card (10s) → 3-2-1 → session → OUTRO card (7s) → fade to black
         → stopRecording. Nothing is cut together afterwards; what OBS captures is the finished video.
         Both cards read the session's own config, so they are never written by hand. ─────────────── */
      :root.stage-count #frame,
      :root.stage-intro #frame,
      :root.stage-outro #frame{ filter:blur(12px) saturate(.95); }

      /* Plain rgba scrim, never backdrop-filter: these cards fade their own opacity, and an animating
         opacity above a backdrop-filter makes it sample an empty group until opacity hits exactly 1. */
      .stage-card{ position:fixed; inset:0; z-index:98; display:none; flex-direction:column;
        align-items:center; justify-content:center; text-align:center; pointer-events:none;
        background:rgba(6,11,26,.44); padding:6vmin; opacity:0; }
      :root.stage-intro #stageIntro, :root.stage-outro #stageOutro{ display:flex; animation:cardIn .9s cubic-bezier(.16,1,.3,1) forwards; }
      @keyframes cardIn{ from{ opacity:0; transform:translateY(14px) } to{ opacity:1; transform:none } }

      .stage-card .brand{ font-family:'Playfair Display',Georgia,serif; font-weight:500;
        font-size:clamp(20px,3.1vmin,34px); letter-spacing:.42em; text-indent:.42em;
        color:#fffaf0; opacity:.86; margin-bottom:clamp(14px,2.6vmin,26px); }
      .stage-card .cfg{ font-family:'Jost',system-ui,sans-serif; font-weight:300;
        font-size:clamp(13px,1.75vmin,19px); letter-spacing:.3em; text-indent:.3em; text-transform:uppercase;
        color:#eaca78; margin-bottom:clamp(20px,3.4vmin,38px); }
      .stage-card h2{ font-family:'Newsreader',Georgia,serif; font-weight:400; margin:0;
        font-size:clamp(21px,3.7vmin,42px); line-height:1.42; color:#fffaf0; max-width:22em;
        text-shadow:0 2px 30px rgba(0,0,0,.4); }
      .stage-card p{ font-family:'Newsreader',Georgia,serif; font-weight:300;
        font-size:clamp(14px,1.95vmin,22px); line-height:1.62; color:#fffaf0; opacity:.8;
        max-width:34em; margin:clamp(14px,2.3vmin,26px) 0 0; }
      .stage-card .rule{ width:min(30vmin,240px); height:1px; margin:clamp(22px,3.6vmin,40px) 0 0;
        background:linear-gradient(90deg,transparent,rgba(255,250,240,.42),transparent); }
      .stage-card .fine{ font-family:'Jost',system-ui,sans-serif; font-weight:300;
        font-size:clamp(11px,1.4vmin,15px); line-height:1.75; letter-spacing:.045em;
        color:#fffaf0; opacity:.62; max-width:36em; margin-top:clamp(12px,2vmin,20px); }
      .stage-card .fine b{ font-weight:400; opacity:.9; letter-spacing:.1em }

      :root.stage-count #frame{ filter:blur(12px) saturate(.95); }
      #stageCount{ position:fixed; inset:0; z-index:98; display:none;
        align-items:center; justify-content:center; pointer-events:none;
        background:rgba(6,11,26,.34); }
      :root.stage-count #stageCount{ display:flex; }
      #stageCount b{ font-family:'NumSerif', Georgia, serif; font-weight:550; color:#fffaf0;
        font-size:min(28vh, 34vw); line-height:1; letter-spacing:-.02em;
        text-shadow:0 2px 40px rgba(0,0,0,.35); }
      @keyframes countPulse{ from{ opacity:0; transform:scale(1.12) } 22%{ opacity:1; transform:none } to{ opacity:.85; transform:none } }
      #stageCount b{ animation:countPulse .9s cubic-bezier(.16,1,.3,1); }

      /* ── Thumbnail studio ─────────────────────────────────────────────────────────────────────── */
      #thumbWrap{ position:fixed; inset:0; z-index:120; display:none; align-items:center; justify-content:center;
        background:rgba(4,8,18,.86); padding:2vmin; }
      :root.thumb-open #thumbWrap{ display:flex; }
      :root.thumb-open #begin{ display:none; }         /* no starting a session from behind the panel */
      #thumbPanel{ width:min(1180px,96vw); max-height:96vh; overflow:auto; background:#0e1420;
        border:1px solid #26303f; border-radius:14px; color:#e6edf3;
        font:14px/1.5 ui-sans-serif,system-ui,-apple-system,Segoe UI,Roboto,sans-serif; }
      .th-head{ display:flex; align-items:center; gap:12px; padding:12px 16px; border-bottom:1px solid #26303f; }
      .th-head b{ font-size:15px; letter-spacing:.02em }
      .th-hint{ color:#8b949e; font-size:12px; margin-right:auto }
      #thumbClose{ background:none; border:0; color:#8b949e; font-size:17px; cursor:pointer; padding:2px 6px }
      #thumbClose:hover{ color:#e6edf3 }
      .th-body{ display:flex; gap:16px; padding:16px; flex-wrap:wrap }
      .th-stageCol{ flex:1 1 620px; min-width:0 }
      #thumbCv{ width:100%; height:auto; display:block; border-radius:10px; cursor:grab;
        box-shadow:0 6px 26px rgba(0,0,0,.45) }
      #thumbCv:active{ cursor:grabbing }
      .th-mob{ display:flex; align-items:center; gap:12px; margin-top:12px }
      #thumbMob{ width:320px; height:180px; flex:0 0 auto; border-radius:6px; box-shadow:0 2px 10px rgba(0,0,0,.4) }
      .th-mob span{ color:#8b949e; font-size:12px; line-height:1.5 }
      .th-side{ flex:0 0 260px; display:flex; flex-direction:column; gap:12px }
      .th-side label{ display:flex; flex-direction:column; gap:4px; font-size:12px; color:#8b949e }
      .th-side label span{ color:#5c6673; font-size:11px }
      .th-side input{ background:#161b22; border:1px solid #26303f; border-radius:7px; color:#e6edf3;
        padding:7px 9px; font:inherit; font-size:13px }
      .th-side input:focus{ outline:none; border-color:#eaca78 }
      .th-btn{ padding:8px 12px; border-radius:8px; border:1px solid #26303f; background:#161b22;
        color:#e6edf3; font:inherit; font-size:13px; cursor:pointer }
      .th-btn:hover{ border-color:#eaca78 }
      .th-pri{ background:#eaca78; border-color:#eaca78; color:#1a1200; font-weight:600 }
      .th-note{ color:#5c6673; font-size:11px; line-height:1.6; margin:2px 0 0 }
      .th-note em{ color:#8b949e; font-style:normal }
      /* the injected trigger, beside Begin */
      #thumbBtn{ position:fixed; left:50%; bottom:calc(var(--begin-b,4.2vh) + 62px); transform:translateX(-50%);
        z-index:60; padding:9px 20px; border-radius:999px; cursor:pointer;
        background:rgba(10,16,28,.5); border:1px solid rgba(255,250,240,.28); color:#fffaf0;
        font-family:'Jost',system-ui,sans-serif; font-weight:300; font-size:13px; letter-spacing:.16em;
        text-transform:uppercase; backdrop-filter:blur(6px); }
      #thumbBtn:hover{ border-color:rgba(255,250,240,.6) }
      :root.thumb-open #thumbBtn, :root:not(.setup-active) #thumbBtn{ display:none }

      /* ── the session ends → fade to black. Back / back-swipe is the way out. ─────────────────────── */
      #stageEnd{ position:fixed; inset:0; z-index:99; background:#000; opacity:0; pointer-events:none;
        transition:opacity 2.4s cubic-bezier(.4,0,.2,1); }
      :root.stage-done #stageEnd{ opacity:1; pointer-events:auto; }
    </style>
  </head>
  <body>
    <div id="lqip"></div>
    <script is:inline define:vars={{ LQIP }}>
      // Same blur-up as the app so a capture never opens on a black frame.
      (function () {
        var h = new Date().getHours() + new Date().getMinutes() / 60;
        var i = h < 4.9 ? 5 : h < 6.1 ? 0 : h < 8.4 ? 1 : h < 18.2 ? 2 : h < 19.65 ? 3 : h < 21.75 ? 4 : 5;
        var el = document.getElementById('lqip');
        if (el && LQIP[i]) el.style.backgroundImage = 'url(' + LQIP[i] + ')';
        var names = ['pre-dawn', 'sunrise', 'midday', 'sunset', 'twilight', 'midnight'];
        var l = document.createElement('link');
        l.rel = 'preload'; l.as = 'image'; l.href = '/plates-phases/' + names[i] + '.webp';
        l.setAttribute('fetchpriority', 'high');       // no crossorigin — see index.astro
        document.head.appendChild(l);
      })();
    </script>

    <SceneWorld />
    <Setup />
    <Session />
    <!-- ── Thumbnail studio (stage only) ─────────────────────────────────────────────────────────────
         Lives HERE, not in Setup.astro, because Setup is shared with the public site and must not grow a
         capture-only button. The trigger is injected next to Begin at runtime. -->
    <div id="thumbWrap" aria-hidden="true">
      <div id="thumbPanel">
        <div class="th-head">
          <b>Thumbnail</b>
          <span class="th-hint">drag the text · scroll a block to resize</span>
          <button id="thumbClose" title="Close">✕</button>
        </div>
        <div class="th-body">
          <div class="th-stageCol">
            <canvas id="thumbCv" width="1280" height="720"></canvas>
            <div class="th-mob">
              <canvas id="thumbMob" width="320" height="180"></canvas>
              <span>320×180 — how it looks in a phone feed. If it does not read here, it does not read.</span>
            </div>
          </div>
          <div class="th-side">
            <label>Line 1 <span>big</span><input id="thL1" type="text" maxlength="24"></label>
            <label>Line 2 <span>passes behind the glass</span><input id="thL2" type="text" maxlength="28"></label>
            <label>Line 3 <span>small, bottom</span><input id="thL3" type="text" maxlength="32"></label>
            <button id="thumbReset" class="th-btn">Reset to config</button>
            <button id="thumbSave" class="th-btn th-pri">Download PNG</button>
            <p class="th-note">Text is auto-filled from the session config. The hourglass is drawn back
              <em>over</em> line 2, so it reads as depth rather than a sticker.</p>
          </div>
        </div>
      </div>
    </div>

    <div id="stageIntro" class="stage-card" aria-hidden="true">
      <div class="brand">SUSTAIN</div>
      <div class="cfg" id="inCfg"></div>
      <h2 id="inWhat"></h2>
      <div class="rule"></div>
      <div class="fine">Recorded in real time, never looped &nbsp;·&nbsp; <b>sustaintimer.com</b></div>
    </div>
    <div id="stageOutro" class="stage-card" aria-hidden="true">
      <div class="brand">SUSTAIN</div>
      <h2>Thank you for focusing.</h2>
      <p id="outDone"></p>
      <div class="rule"></div>
      <div class="fine">Run this session any time, free — <b>sustaintimer.com</b></div>
    </div>
    <div id="stageCount" aria-hidden="true"><b id="stageCountN">3</b></div>
    <div id="stageEnd" aria-hidden="true"></div>

    <script is:inline>
      // A two-state router: Setup ⇄ Session. Setup and Session each own their own behaviour off the hash;
      // this only does what index.astro's controller does for the app — toggle Setup's visibility and the
      // scene's glass blur — minus Home, the landing story and the scroll machinery.
      (function () {
        var root  = document.documentElement;
        var setup = document.getElementById('setupScreen');

        function sync(){
          var onSetup = location.hash !== '#session';
          if (setup){
            setup.classList.toggle('on', onSetup);
            setup.setAttribute('aria-hidden', onSetup ? 'false' : 'true');
          }
          root.classList.toggle('setup-active', onSetup);
          if (onSetup){                                          // going back re-arms the stage
            root.classList.remove('stage-done');
            root.classList.remove('stage-outro');
            root.classList.remove('stage-intro');
          }
        }
        sync();
        addEventListener('hashchange', sync);

        // ── 3-2-1 lead-in ────────────────────────────────────────────────────────────────────────────
        // Session's own hashchange runs first (its inline script is earlier in the document), so by the
        // time we get here the engine has started. We immediately PAUSE it and count 3-2-1 over a blurred
        // scene, then resume. The engine is wall-clock based and subtracts paused time, so the block still
        // runs its exact configured length — and the first counted second is safely inside the recording
        // even if OBS took a moment to start.
        // ── The cards write themselves from the session's own config ───────────────────────────────
        // Nothing here is typed per video: change the Setup and the copy changes with it. This is also
        // the ONLY on-screen text in the whole capture, and relevance counts on-screen text in the first
        // seconds — so the config line doubles as the algorithm's read on what the video is.
        var INTRO_MS = 10000, OUTRO_MS = 7000;
        // The card is on screen for OUTRO_MS, but OBS is told to stop at OUTRO_STOP_MS so the
        // recording ends ON the thank-you card rather than on the fade-out or on black.
        var OUTRO_STOP_MS = 5000;
        var PHASE_NAME = ['pre-dawn','sunrise','midday','sunset','twilight','midnight'];
        // A picked time of day is NOT a static sky. Session.astro's spanDrift() moves the light across that
        // phase's witness window for the whole session (PH_SPAN: sunrise 5.0→8.2, sunset 16.3→18.8, …), so
        // you watch the phase HAPPEN. Saying "a sunrise sky" undersold the one thing no other timer channel
        // has — the sky actually travels.
        // Every phrase starts "a sky ..." so it reads correctly after "under", and every one describes
        // MOVEMENT, because that is what actually happens.
        var PHASE_PHRASE = [
          'a sky easing out of the dark hour into first light',
          'a sky moving from first light into full morning',
          'a sky drifting from late morning into afternoon',
          'a sky sinking from afternoon light down to the horizon',
          'a sky deepening from the last light into dusk',
          'a sky settling from dusk into the small hours'
        ];
        var CYCLE_PHRASE = {
          dawn:'a sky that warms from pre-dawn into full daylight',
          dusk:'a sky that deepens from sunset into night',
          day:'a whole day passing, dawn through to midnight',
          custom:'a sky that moves through the light you chose',
          follow:'a sky that follows the real time of day'
        };
        // Short forms for the config line, matching the roadmap's light names.
        var CYCLE_LABEL = { dawn:'Dawn to Day', dusk:'Dusk to Night', day:'Full Day', custom:'Custom Light' };
        var SOUND_NAME = { sand:'falling sand', ocean:'ocean waves', breeze:'a shore breeze', birds:'seabirds' };

        function set(id, t){ var e = document.getElementById(id); if (e) e.textContent = t; }
        function readCfg(){ try { return JSON.parse(localStorage.getItem('sustain.session') || '{}'); } catch (e){ return {}; } }
        function dur(min){
          if (!min) return 'an open-ended session';
          var h = Math.floor(min / 60), m = min % 60;
          if (!h) return m + ' minutes';
          return h + (h === 1 ? ' hour' : ' hours') + (m ? ' ' + m + ' min' : '');
        }
        function list(a){ return a.length < 2 ? (a[0] || '') : a.slice(0,-1).join(', ') + ' and ' + a[a.length-1]; }

        // Which light is ACTUALLY going to render? Three cases, and the order matters.
        //
        // The trap: `cycle.preset` defaults to 'follow' and is NOT a choice the user made — Setup starts
        // there and only changes it if the Advanced sheet is opened. Reading the preset first therefore
        // made every held time-of-day describe itself as "a sky that follows the real time of day", even
        // though the scene correctly rendered the picked phase. `cycle.seq` is no help either: it defaults
        // to ['midday','sunset','midnight'] regardless of preset. Only these preset IDs really move.
        var MOVING = { dawn:1, dusk:1, day:1, custom:1 };
        function lightOf(c){
          var pre = c.cycle && c.cycle.preset;
          if (pre && MOVING[pre]) return CYCLE_PHRASE[pre] || CYCLE_PHRASE.custom;   // the sky travels
          if (c.followDay) return CYCLE_PHRASE.follow;                               // tracks real time
          return PHASE_PHRASE[c.phase | 0] || 'the shore';                           // one held light
        }
        function lightLabel(c){
          var pre = c.cycle && c.cycle.preset;
          if (pre && MOVING[pre]) return CYCLE_LABEL[pre] || 'Moving Light';
          if (c.followDay) return 'Live Sky';
          return (PHASE_NAME[c.phase | 0] || '').replace('-', ' ');
        }

        function fillIntro(){
          var c = readCfg();
          var light = lightOf(c);
          var snd = (c.sounds || []).map(function (s){ return SOUND_NAME[s]; }).filter(Boolean);
          var d = dur(c.totalMin);

          var bits = [];
          if (c.mode === 'pomodoro')    bits.push(c.pomoFocus + ' / ' + c.pomoBreak + ' Pomodoro');
          else if (c.mode === 'flow')   bits.push('Flow');
          else if (c.mode === 'custom') bits.push('Custom ' + c.customInterval + ' / ' + c.customBreakLen);
          else                          bits.push('Endless');
          bits.push(c.totalMin ? d : 'no set end');
          bits.push(lightLabel(c));
          set('inCfg', bits.join('  ·  '));

          // ONE sentence. The card is on screen for 10s and a viewer should take it in at a glance —
          // the block structure is already in the description's chapters, so it does not belong here too.
          set('inWhat', d.charAt(0).toUpperCase() + d.slice(1) + ' of ambient focus under ' + light
            + (snd.length ? ', with ' + list(snd) + '.' : ', in quiet.'));
        }
        function fillOutro(){
          var c = readCfg();
          set('outDone', c.totalMin ? 'You just completed ' + dur(c.totalMin) + ' of focused work.'
                                    : 'You just completed a full session of focused work.');
        }

        var counting = false, introT = null;
        function leadIn(){
          if (counting) return;
          counting = true;

          // The recording is already rolling, so this card IS the opening frame of the video.
          fillIntro();
          root.classList.add('stage-intro');
          var el = document.getElementById('stageCountN');
          if (el) el.textContent = '3';

          // Park the engine at ZERO the moment it exists and keep it parked through the card AND the
          // count, so the numerals read the full block length (25:00, not 24:59) the whole way in.
          // Budget generously: the card alone is 10s, so a 3s poll window would give up far too early.
          var armed = false, tries = 0;
          var wait = setInterval(function () {
            var S = window.SustainScene;
            var r = S && S.sampleSession && S.sampleSession();
            if (!(r && r.kind && r.kind !== 'idle')) { if (++tries > 400) clearInterval(wait); return; }
            clearInterval(wait);
            try { if (S && S.restartSession){ S.restartSession(true); armed = true; } } catch (e) {}
          }, 50);

          // 3 · 2 · 1 each get a tick; the BELL is reserved for the moment the clock actually starts, so
          // the two sounds mean different things on the tape.
          var beat = function(){ try { if (window.SustainAudio && window.SustainAudio.tick) window.SustainAudio.tick(); } catch (e) {} };

          introT = setTimeout(function () {
            root.classList.remove('stage-intro');
            root.classList.add('stage-count');
            beat();                                     // the "3" is already on screen
            var n = 3;
            var tick = setInterval(function () {
              n -= 1;
              if (n > 0) {
                if (el){ el.textContent = String(n); el.style.animation = 'none'; void el.offsetWidth; el.style.animation = ''; }
                beat();                                 // "2" and "1"
                return;
              }
              clearInterval(tick); clearInterval(wait);
              root.classList.remove('stage-count');
              counting = false;
              try {
                var S = window.SustainScene;
                // Restart from zero rather than resume, so the block begins at exactly its full length.
                if (armed && S && S.restartSession) S.restartSession(false);
                // ...and ring the start bell on the same beat the clock starts.
                if (window.SustainAudio && window.SustainAudio.cue) window.SustainAudio.cue();
              } catch (e) {}
            }, 1000);
          }, INTRO_MS);
        }
        addEventListener('hashchange', function(){
          if (location.hash === '#session') leadIn();
          else {
            clearTimeout(introT);
            root.classList.remove('stage-intro'); root.classList.remove('stage-count');
            counting = false;
          }
        });

        // Begin → fullscreen. requestFullscreen needs a user gesture, so it hangs off the Begin CLICK
        // rather than the hashchange (which fires in a later task and can lose the activation).
        // Begin → fullscreen, EXCEPT under ?record=1.
        //
        // requestFullscreen makes the browser print its own "To exit full screen, press Esc" toast, and on
        // Begin that toast lands squarely on the intro card — i.e. on tape. Inside an OBS Browser Source
        // requestFullscreen was always a no-op (the source is already rendered at 1920×1080), so skipping
        // it in the capture preset costs nothing and removes the toast from the recording entirely.
        //
        // Capturing a real browser window instead of a Browser Source? Press F11 BEFORE Begin — entering
        // fullscreen yourself gets the toast over with while nothing is rolling.
        var REC = /[?&]record=1\b/.test(location.search);
        function goFull(){
          if (REC) return;
          try {
            var el = document.documentElement;
            if (!document.fullscreenElement && el.requestFullscreen) el.requestFullscreen().catch(function(){});
          } catch (e) {}
        }
        var beginBtn = document.getElementById('begin');
        if (beginBtn) beginBtn.addEventListener('click', function () {
          goFull();
          // ...and roll. Same OBS Browser Source API as the auto-stop; a no-op in a normal browser, and it
          // needs the source's Page permissions set to ALL. Guarded on getStatus so pressing Begin twice
          // cannot start a second recording.
          try {
            var obs = window.obsstudio;
            if (!obs || typeof obs.startRecording !== 'function') return;
            if (typeof obs.getStatus === 'function') {
              obs.getStatus(function (st) { if (!st || !st.recording) obs.startRecording(); });
            } else {
              obs.startRecording();
            }
          } catch (e) {}
        });
        // If Esc drops out of fullscreen mid-session, the next interaction puts it back (a gesture is the
        // only thing the browser will accept).
        addEventListener('pointerdown', function(){ if (location.hash === '#session') goFull(); });
        addEventListener('keydown', function(){ if (location.hash === '#session') goFull(); });

        // window.obsstudio is injected ONLY inside an OBS Browser Source, so all of this is a no-op in a
        // normal browser. It needs the source's Page permissions set to **Full access to OBS** — per the
        // obs-browser README, startRecording/stopRecording require ALL permissions, and "Advanced access"
        // is one level short. The symptom of getting that wrong is exact and misleading: Begin works, the
        // session runs perfectly, and the record timer simply never starts.
        function obsStop(){
          try {
            var obs = window.obsstudio;
            if (obs && typeof obs.stopRecording === 'function') obs.stopRecording();
            if (obs && typeof obs.stopStreaming === 'function' && /[?&]stopstream=1\b/.test(location.search)) obs.stopStreaming();
          } catch (e) {}
        }
        // Back to Setup, fully re-armed for the next capture.
        function rearm(){
          done = false; counting = false;
          clearTimeout(introT); clearTimeout(stopT); clearTimeout(fadeT); clearTimeout(homeT);
          root.classList.remove('stage-intro'); root.classList.remove('stage-count');
          root.classList.remove('stage-outro'); root.classList.remove('stage-done');
          location.hash = 'setup';
        }

        // ── Completion ──────────────────────────────────────────────────────────────────────────────
        // The tape should END on the thank-you card, not on black. So the card stays up the full 7 s for
        // anyone watching the stage live, but the STOP signal fires at 5 s — the last thing on the
        // recording is the card, with the fade and the re-arm happening after OBS has already closed the
        // file. Without that split, every video ended with dead black frames.
        var done = false, stopT = null, fadeT = null, homeT = null;
        setInterval(function () {
          // `counting` covers the intro card AND the 3-2-1: during those the previous session's engine
          // state can still read done:true for a beat before restartSession() parks the new one at zero.
          // Without this guard a second capture could fire its outro instantly and record 12 s of card.
          if (done || counting || location.hash !== '#session' || !window.SustainScene || !SustainScene.sampleSession) return;
          var r = SustainScene.sampleSession();
          if (!r || !r.done) return;
          done = true;
          fillOutro();
          root.classList.add('stage-outro');

          stopT = setTimeout(obsStop, OUTRO_STOP_MS);          // 5 s — recording ends on the card
          fadeT = setTimeout(function () {                     // 7 s — card has had its full run
            root.classList.remove('stage-outro');
            root.classList.add('stage-done');                  // 2.4 s fade to black
            // ...and don't sit on black forever: go back to Setup so the next row can be set up
            // immediately. Only after the fade has finished, so the stage still reads as "finished".
            homeT = setTimeout(rearm, 3200);
          }, OUTRO_MS);
        }, 1000);

        // ── Escape hatch ────────────────────────────────────────────────────────────────────────────
        // OBS's Interact window has NO browser chrome — no Back button, no address bar — so a running
        // session was a dead end. Refresh did not help either: the #session hash survives a reload, so
        // the page just re-entered the session (which is why the bootstrap above now forces #setup on
        // every load). Esc or Backspace bails out, and stops any recording in flight so abandoning a take
        // cannot leave OBS quietly recording the Setup screen into a huge orphan file.
        addEventListener('keydown', function (e) {
          if (e.key !== 'Escape' && e.key !== 'Backspace') return;
          if (location.hash !== '#session') return;
          e.preventDefault();
          obsStop();
          rearm();
        });

        // ── Thumbnail studio ────────────────────────────────────────────────────────────────────────
        // 90+ thumbnails is too many to hand-make, and drift between them would cost the series its
        // recognisability. So: text auto-fills from the same cfg that drove the capture, the crop is
        // fixed for the whole catalogue, and the hourglass is composited back OVER line 2 so the type
        // reads as depth. Everything is still draggable/resizable for CTR experiments.
        var TH = {
          top: { x:0.5,  y:0.20, size:0.135 },      // fractions of the frame, so they survive any export size
          bot: { x:0.5,  y:0.90, size:0.045 },
          l1:'', l2:'', l3:''
        };
        var thCv = document.getElementById('thumbCv'), thMob = document.getElementById('thumbMob');
        var thL1 = document.getElementById('thL1'), thL2 = document.getElementById('thL2'), thL3 = document.getElementById('thL3');

        function thDefaults(){
          var c = readCfg(), m = c.totalMin || 0, h = Math.floor(m/60), mm = m%60;
          TH.l1 = m ? (h ? (mm ? h+'H '+mm+'M' : h + (h===1?' HOUR':' HOURS')) : mm+' MIN') : 'ENDLESS';
          TH.l2 = 'STUDY WITH ME';
          TH.l3 = (c.mode === 'pomodoro' ? c.pomoFocus + '/' + c.pomoBreak + ' POMODORO'
                 : c.mode === 'flow' ? 'FLOW' : c.mode === 'endless' ? 'ENDLESS' : 'CUSTOM')
                 + '  ·  ' + lightLabel(c).toUpperCase();
          thL1.value = TH.l1; thL2.value = TH.l2; thL3.value = TH.l3;
        }
        // Text is painted BEFORE the hourglass goes back on top (see SustainScene.thumbFrame), which is
        // what puts line 2 behind the glass.
        function thPaint(o, W, H){
          o.textAlign = 'center'; o.textBaseline = 'middle';
          o.shadowColor = 'rgba(0,0,0,.55)'; o.shadowBlur = Math.round(H*0.02); o.shadowOffsetY = Math.round(H*0.004);
          var s1 = Math.round(H * TH.top.size), s2 = Math.round(s1 * 0.42);
          o.fillStyle = '#fffaf0';
          o.font = '300 ' + s1 + "px 'Jost',system-ui,sans-serif";
          o.fillText(TH.l1, W*TH.top.x, H*TH.top.y);
          o.font = '300 ' + s2 + "px 'Jost',system-ui,sans-serif";
          o.letterSpacing = Math.round(s2*0.18) + 'px';
          o.fillText(TH.l2, W*TH.top.x, H*TH.top.y + s1*0.78);
          var s3 = Math.round(H * TH.bot.size);
          o.font = '300 ' + s3 + "px 'Jost',system-ui,sans-serif";
          o.letterSpacing = Math.round(s3*0.22) + 'px';
          o.fillText(TH.l3, W*TH.bot.x, H*TH.bot.y);
          o.letterSpacing = '0px'; o.shadowBlur = 0; o.shadowOffsetY = 0;
        }
        var thRAF = 0;
        function thDraw(){
          if (!window.SustainScene || !SustainScene.thumbFrame) return;
          var f = SustainScene.thumbFrame({ w:1280, h:720, paint:thPaint });
          thCv.getContext('2d').drawImage(f, 0, 0, 1280, 720);
          var mc = thMob.getContext('2d'); mc.imageSmoothingQuality = 'high';
          mc.drawImage(f, 0, 0, 320, 180);
          if (document.documentElement.classList.contains('thumb-open')) thRAF = requestAnimationFrame(thDraw);
        }
        function thOpen(){
          thDefaults();
          document.documentElement.classList.add('thumb-open');
          (document.fonts ? document.fonts.ready : Promise.resolve()).then(function(){ thDraw(); });
        }
        function thClose(){
          document.documentElement.classList.remove('thumb-open');
          cancelAnimationFrame(thRAF);
        }
        // Drag whichever block you grabbed; wheel resizes it.
        var thDragging = null;
        function thHit(e){
          var r = thCv.getBoundingClientRect(), y = (e.clientY - r.top) / r.height;
          return y < 0.62 ? TH.top : TH.bot;          // top block owns the upper ~2/3
        }
        thCv.addEventListener('pointerdown', function(e){
          thDragging = thHit(e); thCv.setPointerCapture(e.pointerId);
        });
        thCv.addEventListener('pointermove', function(e){
          if (!thDragging) return;
          var r = thCv.getBoundingClientRect();
          thDragging.x = Math.max(0.06, Math.min(0.94, (e.clientX - r.left) / r.width));
          thDragging.y = Math.max(0.06, Math.min(0.94, (e.clientY - r.top) / r.height));
        });
        addEventListener('pointerup', function(){ thDragging = null; });
        thCv.addEventListener('wheel', function(e){
          e.preventDefault();
          var b = thHit(e), k = e.deltaY < 0 ? 1.06 : 1/1.06;
          b.size = Math.max(0.02, Math.min(0.30, b.size * k));
        }, { passive:false });

        [thL1, thL2, thL3].forEach(function(inp, i){
          inp.addEventListener('input', function(){ TH[['l1','l2','l3'][i]] = inp.value; });
        });
        document.getElementById('thumbReset').addEventListener('click', function(){
          TH.top = { x:0.5, y:0.20, size:0.135 }; TH.bot = { x:0.5, y:0.90, size:0.045 }; thDefaults();
        });
        document.getElementById('thumbClose').addEventListener('click', thClose);
        document.getElementById('thumbSave').addEventListener('click', function(){
          var f = SustainScene.thumbFrame({ w:1280, h:720, paint:thPaint });
          f.toBlob(function(b){
            var c = readCfg(), name = 'thumb_' + (c.mode||'x') + '_' + (c.totalMin||0) + 'm_'
                  + lightLabel(c).toLowerCase().replace(/\s+/g,'-') + '.png';
            var a = document.createElement('a');
            a.href = URL.createObjectURL(b); a.download = name; a.click();
            setTimeout(function(){ URL.revokeObjectURL(a.href); }, 4000);
          }, 'image/png');
        });
        addEventListener('keydown', function(e){
          if (e.key === 'Escape' && document.documentElement.classList.contains('thumb-open')){
            e.preventDefault(); e.stopPropagation(); thClose();
          }
        }, true);

        // Inject the trigger beside Begin — Setup.astro is shared with the public site and stays untouched.
        (function(){
          var b = document.createElement('button');
          b.id = 'thumbBtn'; b.type = 'button'; b.textContent = 'Thumbnail';
          b.addEventListener('click', thOpen);
          document.body.appendChild(b);
        })();
      })();
    </script>
  </body>
</html>
