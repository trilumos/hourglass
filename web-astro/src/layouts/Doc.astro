---
// Plain reading layout for the legal pages (/privacy, /terms). No scene, no WebGL, no JS — these load
// instantly and are what the Play Console and the footer link to.
const { frontmatter } = Astro.props;
const SITE = 'https://sustaintimer.com';
const title = (frontmatter?.title ?? 'Sustain') + ' — Sustain';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={frontmatter?.description ?? ''} />
    <link rel="canonical" href={SITE + Astro.url.pathname.replace(/\/$/, '')} />
    <link rel="icon" href="/favicon-round.png" type="image/png" />
    <meta name="theme-color" content="#0a1a2a" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@500&family=Jost:wght@300;400;500&display=swap" rel="stylesheet" />
  </head>
  <body>
    <main class="doc">
      <a class="back" href="/">← Sustain</a>
      <slot />
      <footer>
        <a href="/privacy">Privacy</a> · <a href="/terms">Terms</a> ·
        <a href="mailto:trilumos.app@gmail.com">trilumos.app@gmail.com</a>
      </footer>
    </main>

    <style is:global>
      *{ margin:0; padding:0; box-sizing:border-box; }
      body{ background:#0a1a2a; color:rgba(242,234,217,.86); font-family:Jost,ui-sans-serif,system-ui,sans-serif;
            font-weight:300; line-height:1.68; -webkit-font-smoothing:antialiased; }
      .doc{ max-width:46rem; margin:0 auto; padding:clamp(28px,6vh,64px) clamp(20px,5vw,40px) clamp(48px,9vh,96px);
            font-size:clamp(14.5px,1.05vw,16.5px); }
      .doc h1,.doc h2,.doc h3{ font-family:'Playfair Display',Georgia,serif; font-weight:500; color:#fbf3e2;
            line-height:1.2; }
      .doc h1{ font-size:clamp(28px,3.4vw,42px); margin:.4em 0 .7em; }
      .doc h2{ font-size:clamp(19px,2vw,25px); margin:1.9em 0 .6em; }
      .doc h3{ font-size:clamp(16px,1.5vw,19px); margin:1.5em 0 .5em; }
      .doc p,.doc ul,.doc ol{ margin:0 0 1.05em; }
      .doc ul,.doc ol{ padding-left:1.3em; }
      .doc li{ margin-bottom:.4em; }
      .doc strong{ font-weight:500; color:#fbf3e2; }
      .doc hr{ border:0; border-top:1px solid rgba(255,255,255,.12); margin:2.2em 0; }
      .doc a{ color:#f0d9b2; text-decoration:underline; text-underline-offset:.18em; }
      .doc a:hover{ color:#fbf3e2; }
      .doc code{ font-family:ui-monospace,SFMono-Regular,Menlo,monospace; font-size:.9em;
            background:rgba(255,255,255,.07); padding:.12em .38em; border-radius:5px; }
      .back{ display:inline-block; margin-bottom:1.4em; font-size:.86em; letter-spacing:.04em;
             color:rgba(242,234,217,.6); text-decoration:none; }
      .back:hover{ color:#fbf3e2; }
      .doc footer{ margin-top:3.2em; padding-top:1.4em; border-top:1px solid rgba(255,255,255,.12);
             font-size:.85em; opacity:.6; }
    </style>
  </body>
</html>
