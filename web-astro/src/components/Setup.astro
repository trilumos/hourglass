---
// Setup screen — PHASE 1 shell. Locked design ported VERBATIM from site/setup.html over the PERSISTENT live
// scene (its own static `.scene` plate is stripped — SceneWorld shows through). Controls are inert for now;
// the timer plan (plan.js), themes→scene wiring, Web-Audio mixer, and Begin→cfg come in Phases 2–5.
// Collision-safe renames vs Home: #stage→#setupScreen, #ftVal→#suFtVal. Astro auto-scopes the styles.
---
<div class="setup-screen" id="setupScreen" aria-hidden="true">
  <button class="backbtn frost" id="back" aria-label="Back">&#8592;</button>
  <div class="focused-today" id="focusedToday" aria-label="Focused today">
    <span class="ft-k">Focused today</span><span class="ft-sep">&mdash;</span><span class="ft-v" id="suFtVal">0m</span>
  </div>

  <div class="cluster">
    <div class="constellation">
      <!-- LEFT — Sound -->
      <section class="panel sound frost" aria-label="Sound">
        <div class="p-title">Sound</div>
        <div class="tokens" id="tokens"></div>
        <p class="set-desc amb-note" id="ambNote">All four come with Seascape. Play as many as you like.</p>
        <div class="sound-vol">
          <div class="vol-head"><span class="mini-lbl">Volume</span><span class="vh-right">
            <button class="mix-btn" id="mixBtn" aria-label="Individual volumes" title="Individual volumes"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"/><circle cx="9" cy="7" r="2" fill="currentColor" stroke="none"/><circle cx="15" cy="12" r="2" fill="currentColor" stroke="none"/><circle cx="8" cy="17" r="2" fill="currentColor" stroke="none"/></svg></button>
            <span class="pct" id="volPct">100%</span></span></div>
          <input type="range" id="vol" min="0" max="100" value="100" aria-label="Volume">
        </div>
        <div class="sound-foot">
          <span class="mini-lbl">Listen now</span>
          <button class="preview-tog" id="preview" aria-pressed="false" aria-label="Listen now"><span class="sw"><i></i></span></button>
        </div>
        <p class="set-desc" id="listenDesc">Setup stays quiet. Turn this on to hear your mix before you begin.</p>
      </section>

      <!-- CENTRE — Timer -->
      <div class="timer-col">
        <div class="modes frost" id="modes">
          <span class="pill" id="pill"></span>
          <button class="mode on" data-m="flow">Flow</button
          ><button class="mode" data-m="pomodoro">Pomodoro</button
          ><button class="mode" data-m="custom">Custom</button
          ><button class="mode" data-m="endless">Endless</button>
        </div>
        <section class="panel timer frost" aria-label="Timer">
          <div class="intent-wrap">
            <span class="mini-lbl">Intention</span>
            <input class="intent" id="intent" placeholder="What are you focusing on?">
          </div>
          <div class="readout">
            <div class="r-lbl" id="rLbl">BLOCK LENGTH</div>
            <div class="r-row" id="rRow"></div>
            <div class="r-sub" id="rSub"></div>
          </div>
          <div class="canvas" id="canvas"></div>
        </section>
      </div>

      <!-- RIGHT — Themes -->
      <section class="panel themes frost" aria-label="Themes">
        <div class="themes-scroll">
        <div class="theme-prev">
          <img id="themeImg" alt="Seascape" crossorigin="anonymous">
          <span class="tp-name">Seascape</span>
        </div>
        <button class="select-theme" disabled><span class="k">Seascape · more worlds coming</span></button>
        <div>
          <span class="mini-lbl">Time of day</span>
          <div class="tod-opts" id="tod"></div>
        </div>
        <div class="toggles">
          <div class="toggle-row">
            <span class="tr-k">Sun &amp; moon</span>
            <div class="mini-seg" data-seg="sunmoon">
              <button class="on" data-v="show">Show</button><button data-v="hide">Hide</button>
            </div>
          </div>
          <div class="toggle-row">
            <span class="tr-k">Timer display</span>
            <div class="mini-seg" data-seg="timershow">
              <button data-v="always">Always</button><button data-v="5min">5 min</button
              ><button class="on" data-v="hover">Hover</button><button data-v="never">Never</button>
            </div>
          </div>
          <p class="set-desc" id="timerDesc"></p>
        </div>
        <div class="sec">
          <span class="mini-lbl">Number placement</span>
          <div class="mini-seg" data-seg="place" style="margin-top:.5em">
            <button data-v="horizon">Horizon</button><button class="on" data-v="middle">Middle</button
            ><button data-v="ledge">Ledge</button><button data-v="top">Top</button>
          </div>
        </div>
        <div class="sec">
          <span class="mini-lbl">Numeral fill</span>
          <div class="mini-seg" data-seg="fill" style="margin-top:.5em">
            <button class="on" data-v="solid">Solid</button><button data-v="glass">Glass</button
            ><button data-v="outline">Outline</button>
          </div>
        </div>
        <div class="sec">
          <span class="mini-lbl">Numeral font</span>
          <div class="mini-seg" data-seg="font" style="margin-top:.5em">
            <button class="on" data-v="'Newsreader',serif">Serif</button><button data-v="'Jost',sans-serif">Jost</button>
          </div>
        </div>
        <div class="sec">
          <span class="mini-lbl">Number colour</span>
          <div class="swatches" id="swatches" style="margin-top:.5em">
            <button type="button" class="sw-c" data-c="#ffffff" style="background:#ffffff" aria-label="White"></button
            ><button type="button" class="sw-c" data-c="#f2ecdd" style="background:#f2ecdd" aria-label="Ivory"></button
            ><button type="button" class="sw-c" data-c="#eaca78" style="background:#eaca78" aria-label="Gold"></button
            ><button type="button" class="sw-c" data-c="#8fb7e0" style="background:#8fb7e0" aria-label="Sky"></button
            ><button type="button" class="sw-c" data-c="#20242e" style="background:#20242e" aria-label="Charcoal"></button
            ><label class="sw-c sw-custom" title="Custom colour"><input type="color" id="numColor" value="#ffffff" aria-label="Custom number colour"></label>
          </div>
        </div>
        <button class="advanced-btn" id="advBtn">Advanced settings</button>
        </div>
      </section>
    </div>
  </div>

  <button class="begin" id="begin">Begin</button>

  <!-- Per-sound volume mixer (floats above the panels; positioned by JS near the button) -->
  <div class="mix-pop frost" id="mixPop" hidden>
    <div class="mix-title">Individual volumes</div>
    <div id="mixRows"></div>
  </div>

  <!-- Advanced sheet -->
  <div class="sheet-scrim" id="sheetScrim"></div>
  <div class="sheet frost" id="sheet" role="dialog" aria-modal="true" aria-label="Advanced settings">
    <div class="sheet-head"><h3>Advanced</h3><button class="sheet-close" id="sheetClose" aria-label="Close">&times;</button></div>

    <div class="sec" id="cycleSec">
      <span class="mini-lbl">Light through your session</span>
      <div class="chips presets" id="cycPresets"></div>
      <p class="set-desc" id="cycDesc"></p>
      <div class="cyc-timeline" id="cycTimeline"></div>
      <div class="cyc-key" id="cycKey"></div>
      <div class="cyc-disabled" id="cycDisabled"></div>
      <button class="reveal-btn" id="cycCustomBtn" aria-expanded="false">Build my own sequence</button>
      <div class="reveal" id="cycCustom" hidden>
        <span class="reveal-lbl">Your sequence — tap a light below to add it</span>
        <div class="cyc-seq" id="cycSeq"></div>
        <div class="palette" id="cycPal"></div>
        <div class="toggle-row"><span class="tr-k">Change</span>
          <div class="mini-seg" data-seg="cycChange">
            <button class="on" data-v="once">Once</button><button data-v="loop">Loop</button>
          </div></div>
        <div class="toggle-row" id="loopByRow"><span class="tr-k">Loop by</span>
          <div class="mini-seg" data-seg="cycBy">
            <button class="on" data-v="cycles">Cycles</button><button data-v="minutes">Minutes</button
            ><button data-v="breaks">Breaks</button>
          </div></div>
      </div>
    </div>

    <div class="sec">
      <span class="mini-lbl">Separator</span>
      <div class="mini-seg" data-seg="sep" style="margin-top:.5em">
        <button data-v="colon">Colon</button><button data-v="dot">Dot</button
        ><button class="on" data-v="none">None</button>
      </div>
    </div>
  </div>
</div>

<style>
/* Setup — locked design (site/setup.html), tokens moved onto the .setup-screen root; static plate removed
   (the persistent SceneWorld shows through). Astro scopes all of this to Setup's DOM, so the generic class
   names (.panel/.chip/.step/input[type=range]/…) can't leak to Home or the scene. */
.setup-screen{
  position:fixed; inset:0; z-index:6; container-type:size; isolation:isolate;
  font-family:Jost,system-ui,sans-serif; color:var(--ink);
  opacity:0; visibility:hidden; pointer-events:none;   /* instant state flip; the View Transition cross-fades */
  /* ══ LOCKED PANEL GEOMETRY ══ */
  --gutter: clamp(14px, 2.4cqi, 46px);
  /* --sq drove the whole locked geometry off container HEIGHT only, so a tall narrow phone (390x844) asked
     for a 540px square and a 691px --main-w on a 390px screen: guaranteed horizontal overflow. Also cap it
     at the width the timer column can actually occupy. Desktop and tablet are unchanged (height still wins
     there), so the founder-locked proportions hold; only narrow screens are clamped. */
  --sq:     clamp(280px, min(64cqh, calc((100cqi - 2 * var(--gutter)) / 1.28)), 640px);
  --main-w: calc(var(--sq) * 1.28);
  --modes-w: 78%;
  --pad:    calc(var(--sq) * .055);
  --sp-in:  calc(var(--sq) * .018);
  --sp-grp: calc(var(--sq) * .048);
  --t-xs:   calc(var(--sq) * .0205);
  --t-sm:   calc(var(--sq) * .0256);
  --t-md:   calc(var(--sq) * .032);
  --t-lg:   calc(var(--sq) * .040);
  --t-xl:   calc(var(--sq) * .050);
  --t-2xl:  calc(var(--sq) * .078);
  --t-num:  calc(var(--sq) * .195);
  --ctrl-y: calc(var(--sq) * .023);
  --ctrl-x: calc(var(--sq) * .046);
  --r-inner:calc(var(--sq) * .026);
  --ink:    #f2ecdd;
  --ink-hi: #fdf6e6;
  --ink-dim:#cfc7b6;
  --gold:   #EACA78;
  --warn:   #F0A98C;
  --gsel:   linear-gradient(180deg,#f5e8cc,#e7cf9c);
  --track:  rgba(255,255,255,.16);
  --rule:   rgba(255,255,255,.16);
  --frost-bg:#35353566;
  --e-std:  cubic-bezier(.4,0,.2,1);
}
.setup-screen.on{ opacity:1; visibility:visible; pointer-events:auto; }
.setup-screen *{ box-sizing:border-box; }

/* ── Frost material ── */
.frost{
  background:var(--frost-bg);
  -webkit-backdrop-filter:blur(20px); backdrop-filter:blur(20px);
  box-shadow: inset 0 0 4px -2px #ffffff55, 0 0 4px -2px #ffffff55, 0 22px 55px rgba(0,0,0,.34);
  border:1px solid rgba(255,255,255,.06);
}
@media (prefers-reduced-transparency: reduce){
  .frost{ background:#1a1d26f2; -webkit-backdrop-filter:none; backdrop-filter:none; }
}

/* ── Back button ── */
.backbtn{
  position:absolute; left:var(--gutter); top:var(--gutter); z-index:5;
  width:clamp(34px,3cqi,46px); aspect-ratio:1; border-radius:50%;
  color:var(--ink); font-size:clamp(14px,1.3cqi,20px); line-height:1; cursor:pointer;
  display:flex; align-items:center; justify-content:center;
}
/* Focused-today */
.focused-today{
  position:absolute; top:calc(var(--gutter)*.9); left:50%; transform:translateX(-50%); z-index:5;
  display:flex; align-items:baseline; gap:.5em; white-space:nowrap; text-shadow:0 1px 10px rgba(0,0,0,.5);
}
.focused-today .ft-k{ font-weight:500; letter-spacing:.24em; text-transform:uppercase;
  font-size:calc(var(--sq)*.018); color:#fff; opacity:.72; }
.focused-today .ft-sep{ opacity:.5; font-size:calc(var(--sq)*.02); }
.focused-today .ft-v{ font-weight:500; color:#fff; font-variant-numeric:tabular-nums; font-size:calc(var(--sq)*.026); }

/* ── Constellation ── */
.cluster{ position:absolute; left:0; right:0; top:50%; transform:translateY(-50%); z-index:1; }
.constellation{ display:flex; align-items:center; gap:var(--gutter); padding-inline:var(--gutter); width:100%; min-height:0; }
.panel{ border-radius:clamp(16px,2cqi,26px); padding:var(--pad); display:flex; flex-direction:column; min-width:0; overflow:hidden; }
.panel.sound, .panel.themes{ flex:1 1 0; height:var(--sq); }
.panel.themes{ overflow:hidden; }
.themes-scroll{
  flex:1 1 auto; min-height:0; overflow-y:auto; overscroll-behavior:contain;
  display:flex; flex-direction:column; gap:var(--sp-in); padding:3px 6px 3px 3px;   /* left/top/bottom = room for selected rings that the overflow-x clip would cut */
  scrollbar-width:thin; scrollbar-color:rgba(255,255,255,.18) transparent;
  transform:translateZ(0); will-change:scroll-position;   /* own layer → scroll decoupled from the frost's backdrop-filter */
}
.themes-scroll::-webkit-scrollbar{ width:3px; }
.themes-scroll::-webkit-scrollbar-button{ display:none; width:0; height:0; }
.themes-scroll::-webkit-scrollbar-track, .themes-scroll::-webkit-scrollbar-corner{ background:transparent; }
.themes-scroll::-webkit-scrollbar-thumb{ background:rgba(255,255,255,.18); border-radius:99px; }
.themes-scroll:hover::-webkit-scrollbar-thumb{ background:rgba(255,255,255,.3); }
.timer-col{ position:relative; width:var(--main-w); height:var(--sq); flex:0 0 auto; }
.p-title{ font-weight:500; letter-spacing:.22em; text-transform:uppercase; font-size:var(--t-sm); opacity:.85; margin-bottom:var(--sp-grp); }

/* ═══ CENTRE — Timer ═══ */
.modes{
  position:absolute; bottom:calc(100% + var(--sp-in)*1.4); left:50%; transform:translateX(-50%);
  display:flex; width:var(--modes-w); gap:0; --mp:calc(var(--sq)*.009); --n:0; padding:var(--mp);
  border-radius:100px; white-space:nowrap; z-index:4;
}
/* pill placed purely from --n (active index 0–3) — no JS measurement, so it's correct on the first paint too */
.modes .pill{ position:absolute; top:var(--mp); bottom:var(--mp); z-index:0; border-radius:100px;
  width:calc((100% - 2*var(--mp)) / 4); left:calc(var(--mp) + var(--n) * (100% - 2*var(--mp)) / 4);
  background:#fff; box-shadow:0 1px 6px rgba(0,0,0,.2); transition:left .26s var(--e-std); }
.mode{
  position:relative; z-index:1; flex:1 1 0; font-family:inherit; font-weight:400; font-size:var(--t-md);
  letter-spacing:.04em; color:var(--ink-dim); cursor:pointer; padding:var(--ctrl-y) .5em; border-radius:100px;
  background:none; border:none; transition:color .2s; white-space:nowrap; text-align:center;
}
.mode.on{ color:#181a20; font-weight:500; }
.timer{ width:100%; height:100%; display:flex; flex-direction:column; justify-content:space-between; text-align:center; }
.intent-wrap{ text-align:left; }
.mini-lbl{ font-weight:500; letter-spacing:.2em; text-transform:uppercase; font-size:var(--t-sm); opacity:.8; }
.intent{
  width:100%; background:none; border:none; border-bottom:1px solid var(--rule); color:#fff; font-family:inherit;
  font-weight:400; font-size:var(--t-lg); padding:.5em 0 .55em; margin-top:.45em; outline:none; transition:border-color .2s;
}
.intent::placeholder{ color:rgba(255,255,255,.55); }
.intent:focus{ border-bottom-color:rgba(234,202,120,.75); }
.readout .r-lbl{ text-align:center; font-weight:500; letter-spacing:.2em; text-transform:uppercase; font-size:var(--t-sm); opacity:.8; }
.r-row{ display:flex; align-items:center; justify-content:center; gap:calc(var(--sq)*.05); margin:.16em 0 .2em; }
.r-num{ display:flex; align-items:baseline; justify-content:center; gap:.08em; font-variant-numeric:tabular-nums lining-nums; cursor:text; }
.r-num b{ font-weight:600; font-size:var(--t-num); line-height:.88; letter-spacing:-.03em; color:#fff; }
.r-num s{ text-decoration:none; font-weight:400; font-size:var(--t-2xl); color:#fff; opacity:.8; }
.r-num input{ width:2.2em; background:none; border:none; border-bottom:2px solid #fff; color:#fff; font-family:inherit;
  font-weight:600; text-align:center; font-size:var(--t-num); line-height:.88; outline:none; -moz-appearance:textfield; }
.r-num input::-webkit-outer-spin-button,.r-num input::-webkit-inner-spin-button{ -webkit-appearance:none; }
.step{
  width:calc(var(--sq)*.092); aspect-ratio:1; border-radius:50%; flex:none; cursor:pointer; color:#fff;
  background:rgba(255,255,255,.09); box-shadow: inset 0 0 0 1px rgba(255,255,255,.2); border:none;
  font-size:var(--t-xl); line-height:1; display:flex; align-items:center; justify-content:center; transition:opacity .18s, background .18s;
}
.step:hover{ background:rgba(255,255,255,.18); }
.step.spent{ opacity:.3; pointer-events:none; }
.step.hidden{ visibility:hidden; }
.r-sub{ min-height:2.6em; font-weight:400; line-height:1.45; color:#fff; opacity:.92; font-size:var(--t-md); text-align:center; transition:opacity .2s; }
.r-sub.warn{ color:var(--warn); opacity:1; }
.canvas{ min-height:calc(var(--sq)*.30); display:flex; flex-direction:column; justify-content:flex-end; transition:opacity .2s; }
.hint{ font-weight:400; font-size:var(--t-md); line-height:1.45; opacity:.85; color:#fff; margin-bottom:var(--sp-in); text-align:center; }
.chips{ display:flex; flex-wrap:wrap; gap:var(--sp-in); justify-content:center; }
.chips.grid3{ display:grid; grid-template-columns:repeat(3,1fr); gap:var(--sp-in); }
.chips.grid3 .chip{ width:100%; }
.chips.grid2{ display:grid; grid-template-columns:repeat(2,1fr); gap:var(--sp-in); }
.chips.grid2 .chip{ width:100%; }
.chips.presets{ margin-bottom:var(--sp-in); }
.chip.sm{ font-size:var(--t-sm); padding:calc(var(--ctrl-y)*.62) calc(var(--ctrl-x)*.72); color:rgba(255,255,255,.72); }
.chip.sm.on{ color:#181a20; }
.boxes{ display:grid; grid-template-columns:1fr 1fr; gap:var(--sp-in); }
.box{ background:rgba(255,255,255,.05); border-radius:var(--r-inner); min-width:0;
  padding:calc(var(--ctrl-y)*.68) calc(var(--ctrl-x)*.5); display:flex; align-items:center; justify-content:space-between; gap:calc(var(--sp-in)*.6); }
.box.wide{ grid-column:1 / -1; }
.box .b-k{ text-align:left; font-size:var(--t-sm); font-weight:400; color:#fff; min-width:0; }
.box .b-k .sub{ display:block; font-size:var(--t-xs); opacity:.6; margin-top:1px; letter-spacing:.04em; }
.box .b-ctl{ display:flex; align-items:center; gap:calc(var(--sp-in)*.55); flex:none; }
.box .b-v{ min-width:2.5em; text-align:center; font-size:var(--t-md); font-weight:600; color:#fff; font-variant-numeric:tabular-nums; cursor:text; }
.box.wide .b-v{ font-size:var(--t-lg); }
.box .b-v input{ width:2.4em; background:none; border:none; border-bottom:2px solid #fff; color:#fff; font-family:inherit;
  font-weight:600; text-align:center; font-size:inherit; outline:none; -moz-appearance:textfield; }
.box .step{ width:calc(var(--sq)*.048); font-size:var(--t-sm); }
.box.wide .step{ width:calc(var(--sq)*.055); font-size:var(--t-md); }
.strip{ display:flex; gap:2px; height:calc(var(--sq)*.016); margin-top:var(--sp-in); }
.strip .sg{ border-radius:99px; transition:flex-grow .2s var(--e-std); }
.strip .sg.focus{ background:rgba(255,255,255,.88); }
.strip .sg.rest{ background:rgba(255,255,255,.26); }
.chip{
  font-family:inherit; font-weight:400; font-size:var(--t-md); color:var(--ink); cursor:pointer;
  padding:var(--ctrl-y) var(--ctrl-x); border-radius:100px; background:var(--frost-bg);
  box-shadow: inset 0 0 0 1px rgba(255,255,255,.14); border:none; transition:background .18s,color .18s; white-space:nowrap;
}
.chip:hover{ background:rgba(255,255,255,.16); }
.chip.on{ background:#fff; color:#181a20; font-weight:500; box-shadow:0 1px 6px rgba(0,0,0,.18); }
.endless-note{ margin:auto; max-width:24em; text-align:center; font-weight:400; font-size:var(--t-md); line-height:1.65; color:#fff; opacity:.85; }

/* ═══ LEFT — Sound ═══ */
.panel.sound{ justify-content:center; }
.tokens{ display:grid; grid-template-columns:1fr 1fr; gap:var(--sp-grp); place-items:center; margin:0 auto; width:100%; }
.tok{ background:none; border:none; cursor:pointer; display:flex; flex-direction:column; align-items:center; gap:.6em; padding:0; color:var(--ink); }
.tok-disc{ position:relative; width:calc(var(--sq)*.135); aspect-ratio:1; }
.tok-face{ position:absolute; inset:0; border-radius:50%; background:var(--frost-bg); box-shadow:inset 0 0 0 1px rgba(255,255,255,.18);
  display:flex; align-items:center; justify-content:center; font-size:var(--t-xl); color:#fff;
  transition:background .2s var(--e-std), color .2s var(--e-std), box-shadow .2s; }
.tok[data-on="1"] .tok-face{ background:#fff; color:#181a20; box-shadow:0 1px 8px rgba(0,0,0,.22); }
.tok[data-on="0"] .tok-face{ opacity:.62; }
.tok-face svg{ width:1em; height:1em; display:block; }
.tok-lbl{ font-weight:400; font-size:var(--t-sm); letter-spacing:.02em; }
.tok[data-on="0"] .tok-lbl{ opacity:.62; }
.sound-vol{ margin-top:var(--sp-grp); }
.vol-head{ display:flex; justify-content:space-between; align-items:baseline; margin-bottom:.6em; }
.vol-head .mini-lbl{ opacity:.6; }
.vol-head .pct{ font-variant-numeric:tabular-nums; font-size:var(--t-md); opacity:.9; }
input[type=range]{ -webkit-appearance:none; appearance:none; width:100%; height:calc(var(--sq)*.009); border-radius:99px;
  background:linear-gradient(to right,var(--gold) var(--fill,100%),var(--track) var(--fill,100%)); outline:none; }
input[type=range]::-webkit-slider-thumb{ -webkit-appearance:none; width:calc(var(--sq)*.032); height:calc(var(--sq)*.032);
  border-radius:50%; background:#fff; box-shadow:0 1px 4px rgba(0,0,0,.35); cursor:pointer; }
input[type=range]::-moz-range-thumb{ width:calc(var(--sq)*.032); height:calc(var(--sq)*.032); border:none; border-radius:50%;
  background:#fff; box-shadow:0 1px 4px rgba(0,0,0,.35); cursor:pointer; }
