  .setup-screen .mix-row input[type=range]{ flex:1; }
  .setup-screen .mix-row .mr-v{ width:2.8em; flex:none; text-align:right; font-variant-numeric:tabular-nums; font-size:var(--t-xs); opacity:.7; }
  .setup-screen .mix-empty{ font-size:var(--t-sm); opacity:.6; }
</style>

<!-- plan.js (classic UMD → window.Plan), then Phase-2 timer logic. Sound tokens + time-of-day + audio +
     Begin come in Phases 3–5. Ported VERBATIM from site/setup.html (timer machinery only). -->
<script is:inline src="/js/plan.js"></script>
<script is:inline>
(function(){
  "use strict";
  var Plan = window.Plan; if(!Plan) return;
  var qs=function(s,r){return (r||document).querySelector(s);};
  var qsa=function(s,r){return Array.prototype.slice.call((r||document).querySelectorAll(s));};
  try {
    // ── State (verbatim) ──
    var st={ mode:'flow', flowMin:25,
      pomoFocus:25, pomoBreak:5, blocks:4,
      customMode:'count', customWork:120, customBreaks:3, customInterval:30, customBreakLen:10 };
    var STEPS=Plan.STEPS, fmt=Plan.fmt;
    var readoutKey=function(){ return st.mode==='flow' ? 'flowMin' : null; };

    // ── Timer render ──
    function bigNumberHTML(){
      if(st.mode==='endless') return '<span class="r-num" id="rNum"><b>&#8734;</b></span>';
      var key=readoutKey();
      if(key){ var v=st[key];
        return '<span class="r-num" id="rNum" data-editkey="'+key+'"><b>'+v+'</b><s>min</s></span>'; }
      var tot=Plan.totalMinOf(Plan.buildPlan(st)); var h=Math.floor(tot/60), mm=tot%60;
      var inner = h>0 ? ('<b>'+h+'</b><s>h</s>'+(mm>0?' <b>'+mm+'</b><s>m</s>':'')) : ('<b>'+mm+'</b><s>min</s>');
      return '<span class="r-num" id="rNum">'+inner+'</span>';
    }
    function renderReadout(){
      var lbl = st.mode==='flow' ? 'BLOCK LENGTH' : (st.mode==='endless' ? 'NO SET END' : 'TOTAL TIME');
      qs('#rLbl').textContent=lbl;
      var key=readoutKey();
      var minus='<button class="step'+ (key&&st[key]<=STEPS[key].min?' spent':'') + (key?'':' hidden')+'" data-hold="'+(key||'')+':-1" aria-label="decrease">&#8722;</button>';
      var plus ='<button class="step'+ (key&&st[key]>=STEPS[key].max?' spent':'') + (key?'':' hidden')+'" data-hold="'+(key||'')+':1" aria-label="increase">&#43;</button>';
      qs('#rRow').innerHTML = minus + bigNumberHTML() + plus;
      var sl=Plan.subline(st, Plan.buildPlan(st));
      var sub=qs('#rSub'); sub.innerHTML=sl.t; sub.classList.toggle('warn',!!sl.warn);
      wireHold(); wireNumEdit();
    }

    // ── Control canvas per mode ──
    function box(key,label,isTime,wide){
      var d=STEPS[key].d, sub='step '+(isTime?fmt(d):d);
      return '<div class="box'+(wide?' wide':'')+'"><span class="b-k">'+label+'<span class="sub">'+sub+'</span></span>'
        +'<span class="b-ctl"><button class="step" data-hold="'+key+':-1" aria-label="decrease '+label+'">&#8722;</button>'
        +'<span class="b-v" data-editkey="'+key+'">'+(isTime?fmt(st[key]):st[key])+'</span>'
        +'<button class="step" data-hold="'+key+':1" aria-label="increase '+label+'">&#43;</button></span></div>';
    }
    function stripHTML(){
      return '<div class="strip" aria-hidden="true">'+Plan.buildPlan(st).map(function(s){
        return '<span class="sg '+(s.kind==='rest'?'rest':'focus')+'" style="flex:'+s.min+' 0 0"></span>';
      }).join('')+'</div>';
    }
    function canvasHTML(){
      if(st.mode==='endless'){
        var eblocks=[[25,5],[50,10],[90,15],[52,17]];
        return '<div class="hint">Pick a block — it loops, focus then break, with no set end.</div>'
          +'<div class="chips grid2">'+eblocks.map(function(b){
            var on=(st.pomoFocus===b[0]&&st.pomoBreak===b[1]);
            return '<button class="chip'+(on?' on':'')+'" data-eblock="'+b[0]+','+b[1]+'">'+b[0]+' / '+b[1]+' min</button>';
          }).join('')+'</div>';
      }
      if(st.mode==='flow'){
        var picks=[15,25,30,45,60,90];
        return '<div class="hint">Step the length above, or pick one.</div><div class="chips grid3">'
          +picks.map(function(m){return '<button class="chip'+(m===st.flowMin?' on':'')+'" data-flow="'+m+'">'+m+' min</button>';}).join('')+'</div>';
      }
      if(st.mode==='pomodoro'){
        var picks=[25,50,90];
        return '<div class="chips presets">'+picks.map(function(m){
            return '<button class="chip sm'+(m===st.pomoFocus?' on':'')+'" data-pfocus="'+m+'">'+m+' min</button>';
          }).join('')+'</div>'
          +'<div class="boxes">'+box('pomoFocus','Focus',true,true)
          +box('pomoBreak','Break',true)+box('blocks','Blocks',false)+'</div>'+stripHTML();
      }
      var byInt = st.customMode==='interval';
      return '<div class="chips presets">'
        +'<button class="chip sm'+(byInt?'':' on')+'" data-cmode="count">By count</button>'
        +'<button class="chip sm'+(byInt?' on':'')+'" data-cmode="interval">By interval</button></div>'
        +'<div class="boxes">'+box('customWork','Focus time',true,true)
        +(byInt?box('customInterval','Break every',true):box('customBreaks','Breaks',false))
        +box('customBreakLen','Break length',true)+'</div>'+stripHTML();
    }
    function renderCanvas(){ qs('#canvas').innerHTML=canvasHTML(); wireHold(); wireNumEdit(); }

    // ── Steppers: click = 1 step, hold = ramp after 400ms; type-to-edit ──
    function clampSet(key,v){ var c=STEPS[key]; st[key]=Math.min(c.max,Math.max(c.min,v)); }
    function doStep(key,dir){
      if(key==='customBreaks' && dir>0 && !Plan.canAddBreak(st)) return;
      clampSet(key, st[key]+STEPS[key].d*dir); renderAll();
    }
    var holdT=null, holdI=null;
    function wireHold(){
      qsa('[data-hold]').forEach(function(b){
        if(b._wired) return; b._wired=true;
        var parts=b.dataset.hold.split(':'), key=parts[0], dir=+parts[1];
        if(!key) return;
        b.addEventListener('pointerdown',function(ev){ ev.preventDefault();
          doStep(key,dir);
          holdT=setTimeout(function(){ holdI=setInterval(function(){ doStep(key,dir); },90); },400);
        });
        var stop=function(){ clearTimeout(holdT); clearInterval(holdI); holdT=holdI=null; };
        b.addEventListener('pointerup',stop); b.addEventListener('pointerleave',stop); b.addEventListener('pointercancel',stop);
      });
    }
    function wireNumEdit(){
      qsa('[data-editkey]').forEach(function(el){
        if(el._wired) return; el._wired=true;
        el.addEventListener('click',function(){
          var key=el.dataset.editkey; if(el.querySelector('input')) return;
          var raw=st[key], inp=document.createElement('input'); inp.type='number';
          inp.value=raw; el.textContent=''; el.appendChild(inp); inp.focus(); inp.select();
          var commit=function(){ var v=parseInt(inp.value,10); if(!isNaN(v)) clampSet(key,v); renderAll(); };
          inp.addEventListener('keydown',function(e){
            if(e.key==='Enter'){ commit(); } else if(e.key==='Escape'){ renderAll(); } });
          inp.addEventListener('blur',commit);
        });
      });
    }

    // segmented picks inside the canvas (flow presets / pomo focus / custom mode)
    qs('#canvas').addEventListener('click',function(e){
      var f=e.target.closest('[data-flow]'); if(f){ st.flowMin=+f.dataset.flow; renderAll(); return; }
      var pf=e.target.closest('[data-pfocus]'); if(pf){ st.pomoFocus=+pf.dataset.pfocus; renderAll(); return; }
      var eb=e.target.closest('[data-eblock]'); if(eb){ var pp=eb.dataset.eblock.split(','); st.pomoFocus=+pp[0]; st.pomoBreak=+pp[1]; renderAll(); return; }
      var cm=e.target.closest('[data-cmode]'); if(cm){ st.customMode=cm.dataset.cmode; renderAll(); return; }
    });

    // ── Mode chooser + sliding pill ──
    function setPill(){ var modes=qs('#modes'); if(!modes) return; var on=qs('.mode.on',modes);
      modes.style.setProperty('--n', Math.max(0, qsa('.mode',modes).indexOf(on))); }
    qs('#modes').addEventListener('click',function(e){
      var b=e.target.closest('.mode'); if(!b) return;
      st.mode=b.dataset.m;
      qsa('.mode').forEach(function(x){ x.classList.toggle('on',x===b); });
      setPill(); renderAll();
    });

    // ── PHASES + time-of-day (previews on the SHARED live scene via window.SustainScene) ──
    var PHASES=[
      {id:'pre-dawn', cap:'Pre-dawn', col:'#2b3a5e', pos:'50% 42%'},
      {id:'sunrise',  cap:'Sunrise',  col:'#e6a86b', pos:'50% 40%'},
      {id:'midday',   cap:'Midday',   col:'#7db4e6', pos:'50% 38%'},
      {id:'sunset',   cap:'Sunset',   col:'#e8895f', pos:'50% 42%'},
      {id:'twilight', cap:'Twilight', col:'#6b5a8c', pos:'50% 44%'},
      {id:'midnight', cap:'Midnight', col:'#141c30', pos:'50% 46%'}
    ];
    var phaseById=function(id){ for(var i=0;i<PHASES.length;i++) if(PHASES[i].id===id) return PHASES[i]; return PHASES[2]; };
    var phaseIndex=function(id){ for(var i=0;i<PHASES.length;i++) if(PHASES[i].id===id) return i; return 2; };
    var plateURL=function(id){ return '/plates-phases/'+id+'.webp'; };
    function hourToPhase(h){
      if(h>=4&&h<6) return 'pre-dawn'; if(h>=6&&h<9) return 'sunrise';
      if(h>=9&&h<16) return 'midday';  if(h>=16&&h<19) return 'sunset';
      if(h>=19&&h<21) return 'twilight'; return 'midnight';
    }
    var todSel='follow';
    function currentPlate(){ return todSel==='follow' ? hourToPhase(new Date().getHours()) : todSel; }
    function applyScene(){ if(window.SustainScene) window.SustainScene.setDay(todSel==='follow'?'follow':phaseIndex(todSel)); }
    function renderTod(){
      var opts='<button class="todo'+(todSel==='follow'?' on':'')+'" data-tod="follow">'
        +'<span class="dot follow"></span><span class="cap">Follow my day</span></button>';
      opts+=PHASES.map(function(p){
        return '<button class="todo'+(todSel===p.id?' on':'')+'" data-tod="'+p.id+'">'
          +'<span class="dot" style="background-image:url('+plateURL(p.id)+');background-position:'+p.pos+'"></span>'
          +'<span class="cap">'+p.cap+'</span></button>';
      }).join('');
      qs('#tod').innerHTML=opts;
    }
    qs('#tod').addEventListener('click',function(e){
      var b=e.target.closest('.todo'); if(!b) return;
      todSel=b.dataset.tod; renderTod(); applyScene();
    });

    // ── Number colour swatches ──
    (function(){
      var swEl=qs('#swatches'), numColor=qs('#numColor');
      function reflectSw(){ qsa('.sw-c[data-c]',swEl).forEach(function(b){
        b.classList.toggle('on', b.dataset.c.toLowerCase()===numColor.value.toLowerCase()); }); }
      swEl.addEventListener('click',function(e){ var b=e.target.closest('.sw-c[data-c]'); if(b){ numColor.value=b.dataset.c; reflectSw(); } });
      numColor.addEventListener('input', reflectSw);
      reflectSw();
    })();

    // ── Generic mini-segments (sun/moon, timer show, number-look, sep, cycle) ──
    var segState={ sunmoon:'show', timershow:'hover',
      place:'middle', fill:'solid', font:"'Newsreader',serif", sep:'none',
      cycChange:'once', cycBy:'cycles' };
    var TIMER_DESC={
      always:'The time stays on screen for the whole session.',
      '5min':'The time surfaces briefly every 5 minutes, then fades away.',
      hover:'The time appears when you move the cursor, then fades away.',
      never:'No time on screen — just the hourglass and the scene.'
    };
    function fadeText(el,txt){
      if(!el || el.textContent===txt) return;
      el.style.opacity='0';
      setTimeout(function(){ el.textContent=txt; el.style.opacity=''; },140);
    }
    function renderTimerDesc(){ fadeText(qs('#timerDesc'), TIMER_DESC[segState.timershow]); }
    function applySepForMode(){
      var noSep=(segState.place==='middle'||segState.place==='ledge');
      if(noSep) segState.sep='none'; else if(segState.sep==='none') segState.sep='colon';
      qsa('[data-seg="sep"] button').forEach(function(c){
        var isNone=c.dataset.v==='none';
        c.disabled = noSep ? !isNone : isNone;
        c.classList.toggle('on', c.dataset.v===segState.sep);
      });
    }
    document.addEventListener('click',function(e){
      var btn=e.target.closest('.mini-seg button'); if(!btn) return;
      var seg=btn.parentElement.dataset.seg; segState[seg]=btn.dataset.v;
      qsa('button',btn.parentElement).forEach(function(x){ x.classList.toggle('on',x===btn); });
      if(seg==='timershow') renderTimerDesc();
      if(seg==='place'||seg==='sep') applySepForMode();
      if(seg==='sunmoon' && window.SustainScene) window.SustainScene.setSunMoon(segState.sunmoon==='show');
      if(seg==='cycChange'||seg==='cycBy'){ cycPreset='custom';
        qs('#loopByRow').style.display= segState.cycChange==='loop'?'flex':'none'; renderCycle(); }
    });

    // ── Cycle builder (advanced sheet) ──
    var cycSeq=['midday','sunset','midnight']; var cycRepeat=2, cycMinutes=30;
    var CYC_PRESETS=[
      { id:'follow', label:'Follow my day', seq:null, desc:'The sky moves with your real time of day, exactly like outside.' },
      { id:'hold',   label:'Hold one light', seq:'single', desc:'One steady light for the whole session — the time of day you picked.' },
      { id:'dawn',   label:'Into the day', seq:['pre-dawn','sunrise','midday'], desc:'Cool pre-dawn light warms into full daylight as your session goes on.' },
      { id:'dusk',   label:'Into the night', seq:['sunset','twilight','midnight'], desc:'Warm evening light deepens into night as your session goes on.' },
      { id:'day',    label:'A whole day', seq:['pre-dawn','sunrise','midday','sunset','twilight','midnight'], desc:'A full day passes — dawn through to midnight — across your session.' }
    ];
    var cycPreset='follow';
    var presetById=function(id){ for(var i=0;i<CYC_PRESETS.length;i++) if(CYC_PRESETS[i].id===id) return CYC_PRESETS[i]; return null; };
    function renderCycPresets(){
      qs('#cycPresets').innerHTML=CYC_PRESETS.map(function(p){
        return '<button class="chip sm'+(p.id===cycPreset?' on':'')+'" data-cyc="'+p.id+'">'+p.label+'</button>';
      }).join('');
    }
    function renderCyclePalette(){
      qs('#cycPal').innerHTML=PHASES.map(function(p){
        return '<button class="pal" data-add="'+p.id+'"><span class="sw-dot" style="background:'+p.col+'"></span>'+p.cap+'</button>';
      }).join('');
    }
    function sessionTotal(){ return st.mode==='endless'? null : Plan.totalMinOf(Plan.buildPlan(st)); }
    function nBreaks(){ return Plan.restsOf(Plan.buildPlan(st)).length; }
    function renderCycle(){
      renderCycPresets();
      var tl=qs('#cycTimeline'), preset=presetById(cycPreset);
      qs('#cycDesc').textContent = preset ? preset.desc : 'Your own sequence, in the order you set it below.';
      qs('#cycSeq').innerHTML=cycSeq.map(function(id,i){ var p=phaseById(id);
        return '<span class="seqchip"><span class="sw-dot" style="background:'+p.col+'"></span>'+p.cap
          +'<span class="x" data-rm="'+i+'">&times;</span></span>'; }).join('');
      if(cycPreset==='follow'){
        tl.style.display='flex'; tl.style.background='linear-gradient(90deg,'+PHASES.map(function(p){return p.col;}).join(',')+')';
        tl.innerHTML=''; qs('#cycKey').textContent='Follows your real clock'; qs('#cycDisabled').textContent=''; return;
      }
      tl.style.background='';
      var seq = cycPreset==='hold' ? [currentPlate()] : cycSeq;
      var T=sessionTotal(), n=seq.length, msg='', segs=[];
      var change=segState.cycChange, by=segState.cycBy;
      if(!n){ msg='Add at least one light below.'; }
      else if(n===1){ segs=['<span class="tseg" style="width:100%;background:'+phaseById(seq[0]).col+'"></span>']; }
      else if(st.mode==='endless' && (change==='once' || (change==='loop'&&by==='cycles')))
        msg='Endless has no set end — loop by Minutes or Breaks instead.';
      else if((st.mode==='flow'||st.mode==='endless') && change==='loop' && by==='breaks')
        msg='This mode has no breaks — loop by Cycles or Minutes instead.';
      else {
        var durs=[];
        if(change==='once'){ for(var i=0;i<n;i++) durs.push(T/n); }
        else if(by==='cycles'){ for(var j=0;j<n*cycRepeat;j++) durs.push(T/(n*cycRepeat)); }
        else if(by==='minutes'){ var left=T||(n*cycMinutes); var k=0; while(left>0){ var take=Math.min(left,cycMinutes); durs.push(take); left-=take; k++; if(k>64)break; } }
        else if(by==='breaks'){ var b=Math.max(1,nBreaks()+1); for(var m=0;m<b;m++) durs.push((T||0)/b); }
        var tot=durs.reduce(function(a,x){return a+x;},0)||1;
        segs=durs.map(function(d,i){ var p=phaseById(seq[i%n]);
          return '<span class="tseg" style="width:'+(d/tot*100)+'%;background:'+p.col+'"></span>'; });
      }
      tl.innerHTML=segs.join(''); tl.style.display=segs.length?'flex':'none';
      qs('#cycDisabled').textContent=msg;
      qs('#cycKey').textContent = segs.length ? seq.map(function(id){return phaseById(id).cap;}).join(' · ') : '';
    }
    qs('#cycPresets').addEventListener('click',function(e){
      var b=e.target.closest('[data-cyc]'); if(!b) return;
      cycPreset=b.dataset.cyc; var p=presetById(cycPreset);
      if(p && Array.isArray(p.seq)) cycSeq=p.seq.slice();
      renderCycle();
    });
    function toCustom(){ cycPreset='custom'; }
    qs('#cycCustomBtn').addEventListener('click',function(){
      var box=qs('#cycCustom'), open=box.hasAttribute('hidden');
      if(open){ box.removeAttribute('hidden'); } else { box.setAttribute('hidden',''); }
      this.classList.toggle('open',open); this.setAttribute('aria-expanded',String(open));
      this.textContent = open ? 'Hide the sequence builder' : 'Build my own sequence';
      if(open){ qs('#loopByRow').style.display= segState.cycChange==='loop'?'flex':'none'; }
    });
    qs('#cycSeq').addEventListener('click',function(e){ var x=e.target.closest('[data-rm]'); if(!x) return;
      cycSeq.splice(+x.dataset.rm,1); toCustom(); renderCycle(); });
    qs('#cycPal').addEventListener('click',function(e){ var a=e.target.closest('[data-add]'); if(!a) return;
      if(cycSeq.length<8) cycSeq.push(a.dataset.add); toCustom(); renderCycle(); });

    // ── Advanced sheet open/close ──
    function openSheet(o){ qs('#sheet').classList.toggle('open',o); qs('#sheetScrim').classList.toggle('open',o);
      if(o){ qs('#loopByRow').style.display= segState.cycChange==='loop'?'flex':'none'; renderCycle(); } }
    qs('#advBtn').addEventListener('click',function(){ openSheet(true); });
    qs('#sheetClose').addEventListener('click',function(){ openSheet(false); });
    qs('#sheetScrim').addEventListener('click',function(){ openSheet(false); });
    document.addEventListener('keydown',function(e){ if(e.key==='Escape') openSheet(false); });

    // ══ PHASE 4 — Sound (tokens + mixer + live Web Audio engine), ported VERBATIM from setup.html ══
    var ICON_BIRD='<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" '
      +'stroke-linecap="round" aria-hidden="true"><path d="M2.5 13.5c3.4-7 6.6-7 9.5 0 2.9-7 6.1-7 9.5 0"/></svg>';
    var SOUNDS=[
      {id:'sand',  label:'Sand',        icon:'○', on:0},
      {id:'ocean', label:'Ocean',       icon:'〜', on:0},
      {id:'breeze',label:'Shore breeze',icon:'≈', on:0},
      {id:'birds', label:'Seabirds',    icon:ICON_BIRD, on:0}
    ];
    var previewOn=false, masterPos=100;
    function gainFor(){ return Math.pow((masterPos/100),2.5); }
    function renderTokens(){
      qs('#tokens').innerHTML = SOUNDS.map(function(s){
        return '<button class="tok" data-snd="'+s.id+'" data-on="'+s.on+'" aria-pressed="'+(s.on?'true':'false')+'">'
          +'<span class="tok-disc"><span class="tok-face">'+s.icon+'</span></span>'
          +'<span class="tok-lbl">'+s.label+'</span></button>';
      }).join('');
    }
    function renderSoundNote(){
      var on={};
      SOUNDS.forEach(function(s){ if(s.on){ on[s.id]=1; } });
      var lines=[];
      if(on.sand && on.ocean) lines.push('Sand settles to a whisper beneath the waves.');
      if(on.birds) lines.push('Seabirds drift in over the shore, then fade back out — over and over.');
      if(!lines.length) lines.push('All four come with Seascape. Play as many as you like.');
      fadeText(qs('#ambNote'), lines.join(' '));
    }
    qs('#tokens').addEventListener('click',function(e){
      var b=e.target.closest('.tok'); if(!b) return;
      var s=SOUNDS.filter(function(x){return x.id===b.dataset.snd;})[0];
      s.on = s.on?0:1; renderTokens(); renderSoundNote(); syncAudio();
      if(!qs('#mixPop').hasAttribute('hidden')) renderMixRows();
    });

    // ── Per-sound volume mixer ──
    function renderMixRows(){
      var on=SOUNDS.filter(function(s){ return s.on; });
      qs('#mixRows').innerHTML = on.length ? on.map(function(s){
        var v=SOUND_VOL[s.id]==null?100:SOUND_VOL[s.id];
        return '<div class="mix-row"><span class="mr-k">'+s.label+'</span>'
          +'<input type="range" min="0" max="100" value="'+v+'" data-mix="'+s.id+'" style="--fill:'+v+'%" aria-label="'+s.label+' volume">'
          +'<span class="mr-v" data-mixv="'+s.id+'">'+v+'%</span></div>';
      }).join('') : '<div class="mix-empty">No sounds on — pick one above first.</div>';
    }
    qs('#mixRows').addEventListener('input',function(e){
      var r=e.target.closest('[data-mix]'); if(!r) return;
      var id=r.dataset.mix, v=+r.value;
      SOUND_VOL[id]=v; r.style.setProperty('--fill',v+'%');
      qs('[data-mixv="'+id+'"]').textContent=v+'%';
      applyVol(id);
    });
    qs('#mixBtn').addEventListener('click',function(e){
      e.stopPropagation();
      var pop=qs('#mixPop');
      if(pop.hasAttribute('hidden')){
        renderMixRows(); pop.removeAttribute('hidden');
        var r=this.getBoundingClientRect();
        pop.style.left=Math.max(8, Math.min(r.right-pop.offsetWidth, window.innerWidth-pop.offsetWidth-8))+'px';
        pop.style.top=(r.bottom+8)+'px';
      } else pop.setAttribute('hidden','');
    });
    document.addEventListener('click',function(e){
      var pop=qs('#mixPop');
      if(!pop.hasAttribute('hidden') && !pop.contains(e.target) && !e.target.closest('#mixBtn'))
        pop.setAttribute('hidden','');
    });
    qs('#vol').addEventListener('input',function(e){
      masterPos=+e.target.value; qs('#volPct').textContent=masterPos+'%';
      e.target.style.setProperty('--fill',masterPos+'%'); syncAudio();
    });
    qs('#preview').addEventListener('click',function(){
      previewOn=!previewOn; this.classList.toggle('on',previewOn); this.setAttribute('aria-pressed',String(previewOn)); syncAudio();
    });

    // ── Audio engine (gapless crossfaded loops, loudness gains, tone-notch, ocean→sand sidechain, bird tide) ──
    var AUDIO_FILE={ sand:'sand.m4a', ocean:'ocean.mp3', breeze:'breeze.mp3', birds:'birds.mp3' };
    var LOOP_POINTS={ sand:[0.15,13.20], ocean:[0.35,70.0], breeze:[0.35,97.846], birds:[0.0,22.5] };
    var SOUND_GAIN={ sand:26, ocean:2.2, breeze:0.40, birds:8.0 };
    var SOUND_VOL={ sand:100, ocean:100, breeze:100, birds:100 };
    var DUCK={ breeze:{ ocean:0.60 } };
    var sandDuck=null, oceanTap=null, scRAF=null;
    var SC_LO=0.02, SC_HI=0.13, SC_DEPTH=0.72, SC_SMOOTH=0.05;
    function isOn(id){ for(var i=0;i<SOUNDS.length;i++) if(SOUNDS[i].id===id) return !!SOUNDS[i].on; return false; }
    function duckFactor(id){ var d=DUCK[id], f=1; if(d) for(var k in d) if(isOn(k)) f*=d[k]; return f; }
    function userMult(id){ return Math.pow((SOUND_VOL[id]==null?100:SOUND_VOL[id])/100, 2.5); }
    function baseGain(id){ return (SOUND_GAIN[id]||1)*userMult(id)*duckFactor(id); }
    var TONE_HZ={ breeze:10870, sand:16970, birds:10853, ocean:19450 };
    var LOWPASS_HZ={ sand:12000, ocean:16000, breeze:9000, birds:9000 };
    var HIGHPASS_HZ={ birds:220 };
    var BIRD_TIDE=[1.0, 0.06, 12];
    var AC=null, master=null, A={};
    function ensureAudio(){
      if(AC) return;
      AC=new (window.AudioContext||window.webkitAudioContext)();
      var lim=AC.createDynamicsCompressor();
      lim.threshold.value=-1.5; lim.knee.value=0; lim.ratio.value=20;
      lim.attack.value=0.003; lim.release.value=0.15;
      master=AC.createGain(); master.gain.value=0;
      master.connect(lim); lim.connect(AC.destination);
    }
    function fileFor(id){ return '/assets/audio/'+(AUDIO_FILE[id]||id+'.mp3'); }
    function loadBuffer(id){
      var n=A[id]=A[id]||{};
      if(n.buffer) return Promise.resolve(n.buffer);
      if(n.dead)   return Promise.resolve(null);
      if(n.loading) return n.loading;
      n.loading=fetch(fileFor(id))
        .then(function(r){ if(!r.ok) throw new Error('HTTP '+r.status); return r.arrayBuffer(); })
        .then(function(b){ return AC.decodeAudioData(b); })
        .then(function(buf){ n.buffer=buf; n.loading=null; return buf; })
        .catch(function(){ n.dead=true; n.loading=null; return null; });
      return n.loading;
    }
    function filterChain(id,from){
      var tail=from, made=[];
      if(TONE_HZ[id]){
        [ [TONE_HZ[id],8,-30], [TONE_HZ[id],20,-24] ].forEach(function(p){
          var b=AC.createBiquadFilter(); b.type='peaking';
          b.frequency.value=p[0]; b.Q.value=p[1]; b.gain.value=p[2];
          tail.connect(b); tail=b; made.push(b);
        });
      }
      if(HIGHPASS_HZ[id]){
        for(var h=0;h<2;h++){
          var hpf=AC.createBiquadFilter(); hpf.type='highpass';
          hpf.frequency.value=HIGHPASS_HZ[id]; hpf.Q.value=0.707;
          tail.connect(hpf); tail=hpf; made.push(hpf);
        }
      }
      for(var i=0;i<2;i++){
        var l=AC.createBiquadFilter(); l.type='lowpass';
        l.frequency.value=(LOWPASS_HZ[id]||9000); l.Q.value=0.707;
        tail.connect(l); tail=l; made.push(l);
      }
      return { tail:tail, nodes:made };
    }
    function attachBirdTide(n){
      var p=BIRD_TIDE, G=baseGain('birds');
      n.bus.gain.value=(p[0]+p[1])/2*G;
      n.lfo=AC.createOscillator(); n.lfo.type='sine'; n.lfo.frequency.value=1/p[2];
      n.lfoGain=AC.createGain(); n.lfoGain.gain.value=(p[0]-p[1])/2*G;
      n.lfo.connect(n.lfoGain); n.lfoGain.connect(n.bus.gain);
      n.lfo.start();
    }
    function applyVol(id){
      var n=A[id]; if(!n||!n.bus) return;
      var t=AC.currentTime;
      if(id==='birds'){
        var p=BIRD_TIDE, G=baseGain('birds');
        n.bus.gain.setTargetAtTime((p[0]+p[1])/2*G, t, 0.08);
        if(n.lfoGain) n.lfoGain.gain.setTargetAtTime((p[0]-p[1])/2*G, t, 0.08);
      } else {
        n.bus.gain.setTargetAtTime(baseGain(id), t, 0.08);
      }
    }
    var XFADE={ sand:0.4, ocean:4.0, breeze:4.0, birds:5.0 };
    var WIN_N=512;
    function sineWindow(scale){
      var w=new Float32Array(WIN_N);
      for(var i=0;i<WIN_N;i++) w[i]=scale*Math.sin(Math.PI*i/(WIN_N-1));
      w[0]=w[WIN_N-1]=0.0001;
      return w;
    }
    var FADE_N=64, FADE_IN=new Float32Array(FADE_N), FADE_OUT=new Float32Array(FADE_N);
    (function(){ for(var i=0;i<FADE_N;i++){ var th=i/(FADE_N-1)*Math.PI/2;
        FADE_IN[i]=Math.sin(th); FADE_OUT[i]=Math.cos(th); } })();
    function pumpLoop(id){
      var n=A[id]; if(!n||!n.seg) return;
      var horizon=AC.currentTime+1.2;
      while(n.next<horizon){
        var t=n.next, S=n.seg;
        var src=AC.createBufferSource(); src.buffer=n.buffer;
        var g=AC.createGain();
        if(S.win){ g.gain.setValueCurveAtTime(S.win,t,S.d); }
        else { g.gain.setValueCurveAtTime(FADE_IN,t,S.xf); g.gain.setValueCurveAtTime(FADE_OUT,t+S.d-S.xf,S.xf); }
        src.connect(g); g.connect(n.bus);
        src.start(t,S.s,S.d+0.02); src.stop(t+S.d+0.02);
        (function(a,b){ a.onended=function(){ try{ a.disconnect(); b.disconnect(); }catch(e){} }; })(src,g);
        n.live.push(src); if(n.live.length>8) n.live.shift();
        n.next = t + S.hop;
      }
    }
    function startSound(id){
      var n=A[id]=A[id]||{};
      if(!n.buffer||n.bus) return;
      var lp=LOOP_POINTS[id]||[0,n.buffer.duration];
      var d=lp[1]-lp[0];
      n.bus=AC.createGain(); n.bus.gain.value=baseGain(id);
      if(id==='birds') attachBirdTide(n);
      var ch=filterChain(id,n.bus); n.chain=ch;
      if(id==='sand'){ sandDuck=AC.createGain(); sandDuck.gain.value=1; ch.tail.connect(sandDuck); sandDuck.connect(master); }
      else { ch.tail.connect(master); }
      if(id==='ocean'){ oceanTap=AC.createAnalyser(); oceanTap.fftSize=256; oceanTap.smoothingTimeConstant=0.3; ch.tail.connect(oceanTap); }
      startSidechain();
      var spec=XFADE[id]||2;
      if(spec<=1){ n.seg={ s:lp[0], d:d, hop:d*spec, win:sineWindow(Math.sqrt(2*spec)) }; }
      else { var xf=Math.min(spec, d/2); n.seg={ s:lp[0], d:d, hop:d-xf, xf:xf }; }
      n.next=AC.currentTime+0.06; n.live=[];
      n.pump=setInterval(function(){ pumpLoop(id); },300);
      pumpLoop(id);
    }
    function stopSound(id){
      var n=A[id]; if(!n||!n.bus) return;
      clearInterval(n.pump); n.pump=null;
      if(n.lfo){ try{ n.lfo.stop(); n.lfo.disconnect(); n.lfoGain.disconnect(); }catch(e){} n.lfo=null; n.lfoGain=null; }
      (n.live||[]).forEach(function(s){ try{ s.stop(); s.disconnect(); }catch(e){} });
      if(id==='sand' && sandDuck){ try{ sandDuck.disconnect(); }catch(e){} sandDuck=null; }
      if(id==='ocean'){ oceanTap=null; if(sandDuck) sandDuck.gain.setTargetAtTime(1, AC.currentTime, 0.12); }
      try{ n.bus.disconnect(); }catch(e){}
      if(n.chain) n.chain.nodes.forEach(function(f){ try{ f.disconnect(); }catch(e){} });
      n.bus=null; n.chain=null; n.seg=null; n.live=null;
    }
    function startSidechain(){ if(scRAF==null) sidechainTick(); }
    function sidechainTick(){
      if(sandDuck && oceanTap){
        var buf=new Float32Array(oceanTap.fftSize); oceanTap.getFloatTimeDomainData(buf);
        var s=0; for(var i=0;i<buf.length;i++) s+=buf[i]*buf[i];
        var rms=Math.sqrt(s/buf.length);
        var x=Math.max(0,Math.min(1,(rms-SC_LO)/(SC_HI-SC_LO)));
        sandDuck.gain.setTargetAtTime(1 - x*SC_DEPTH, AC.currentTime, SC_SMOOTH);
        scRAF=requestAnimationFrame(sidechainTick);
      } else { scRAF=null; }
    }
    function syncAudio(){
      if(!previewOn && !AC) return;
      ensureAudio();
      if(AC.state==='suspended') AC.resume();
      var wanted=SOUNDS.filter(function(s){ return s.on; }).map(function(s){ return s.id; });
      Promise.all(previewOn ? wanted.map(loadBuffer) : []).then(function(){
        SOUNDS.forEach(function(s){ if(previewOn && s.on) startSound(s.id); else stopSound(s.id); });
        SOUNDS.forEach(function(s){ if(previewOn && s.on) applyVol(s.id); });
        var t=AC.currentTime;
        master.gain.cancelScheduledValues(t);
        master.gain.setTargetAtTime(previewOn?gainFor():0, t, 0.08);
        var missing=wanted.filter(function(id){ return A[id]&&A[id].dead; });
        qs('#listenDesc').textContent = !previewOn
          ? 'Setup stays quiet. Turn this on to hear your mix before you begin.'
          : (missing.length ? 'Playing. Not sourced yet: '+missing.join(', ')+'.'
                            : 'Playing your mix. Turn off to go quiet again.');
      });
    }

    // ── PHASE 5 — Begin: build the session config (the exact object the Session reads), save it, hand off ──
    qs('#begin').addEventListener('click',function(){
      this.textContent='Focusing…';
      var VIS={ always:'always', '5min':'always', hover:'hover', never:'hidden' };   // 5min→always for v1
      var pi=PHASES.map(function(p){return p.id;}).indexOf(todSel);
      var cfg={};
      for(var k in st) cfg[k]=st[k];                                   // mode + all mode-specific plan fields
      cfg.place = segState.place;                                      // horizon|middle|ledge|top
      cfg.fill  = segState.fill;                                       // solid|glass|outline
      cfg.font  = segState.font;                                       // 'Newsreader',serif | 'Jost',sans-serif
      cfg.sep   = segState.sep;                                        // colon|dot|none
      cfg.color = qs('#numColor').value;                              // #rrggbb
      cfg.vis   = VIS[segState.timershow] || 'always';               // always|hover|hidden
      cfg.followDay = (todSel==='follow');
      cfg.phase = cfg.followDay ? 2 : (pi<0 ? 2 : pi);                // 0-5
      cfg.autoContrast = true;
      cfg.sounds = SOUNDS.filter(function(s){return s.on;}).map(function(s){return s.id;});
      cfg.vol = masterPos;                                            // master 0-100
      cfg.soundVol = { sand:SOUND_VOL.sand, ocean:SOUND_VOL.ocean, breeze:SOUND_VOL.breeze, birds:SOUND_VOL.birds };
      cfg.intention = (qs('#intent') && qs('#intent').value.trim()) || '';
      cfg.sunmoon = segState.sunmoon;                                  // show | hide
      // advanced "Light through your session" — the phase sequence + timing the session progresses the sky through
      cfg.cycle = { preset:cycPreset, seq:cycSeq.slice(), change:segState.cycChange, by:segState.cycBy, repeat:cycRepeat, minutes:cycMinutes };
      localStorage.setItem('sustain.session', JSON.stringify(cfg));
      sessionStorage.setItem('sustain.armed','1');   // one-shot the Session consumes on first load
      location.hash='session';                       // Session screen (reads the cfg) is the next roadmap item
    });

    // ── Master render + init ──
    function renderAll(){ renderReadout(); renderCanvas(); }
    renderAll();
    setPill();   // pure CSS index — correct on first paint
    renderTod(); qs('#themeImg').src=plateURL('midday');
    renderTokens(); renderSoundNote(); qs('#vol').style.setProperty('--fill','100%');
    qs('#timerDesc').textContent=TIMER_DESC[segState.timershow];
    applySepForMode();
    renderCyclePalette(); renderCycPresets();
    // preview the chosen time-of-day + mix while on Setup; on leaving, stop the preview mix (the Session runs
    // its own audio) and only force the live clock when going HOME (the Session controls its own day/phase).
    window.addEventListener('hashchange',function(){
      var h=location.hash;
      if(h==='#setup'){ applyScene(); try{ qs('#begin').textContent='Begin'; }catch(e){} return; }   // reset the button (was 'Focusing…')
      if(previewOn){ previewOn=false; try{ qs('#preview').classList.remove('on'); qs('#preview').setAttribute('aria-pressed','false'); }catch(e){} syncAudio(); }
      if(h!=='#session' && window.SustainScene) window.SustainScene.setDay('follow');
    });
  } catch(err){ if(window.console) console.error('Setup init', err); }
})();
</script>
