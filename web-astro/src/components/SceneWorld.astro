---
// The LIVING WORLD (spec §0) — ported VERBATIM from web-prototype/hybrid.html.
// - #ui (lab slider panel) is kept but hidden so the tuned module's getElementById calls all resolve.
// - #session-ui (basic Begin/Pause) is TEMPORARY, so the scene can be driven + the sand seen; it and the
//   lab UI get replaced by the real Setup/Session states when the UI is layered.
// - The scene logic lives in ../scene/scene.js (verbatim) + ../scene/shaders.js (verbatim GLSL).
---


<div id="stage"><div id="frame">
  <canvas id="glitter"></canvas>
  <div id="nums">
    <span id="mm" class="clocknum">25</span>
    <span id="sep" class="clocknum"></span>
    <span id="ss" class="clocknum">00</span>
  </div>
  <canvas id="occ"></canvas>
  <canvas id="sand"></canvas>
</div></div>

<div id="err"></div>

<div id="session-ui">
  <div id="focused-today"></div>
  <div class="modes">
    <button class="mode on" data-mode="flow">Flow</button>
    <button class="mode" data-mode="pomodoro">Pomodoro</button>
    <button class="mode" data-mode="custom">Custom</button>
    <button class="mode" data-mode="endless">Endless</button>
  </div>
  <div class="durs">
    <label id="wWrap">Focus <input type="number" id="workMin" min="1" max="180" value="25"> min</label>
    <label id="bWrap">Break <input type="number" id="breakMin" min="1" max="60" value="5"> min</label>
    <label id="rWrap">Rounds <input type="number" id="rounds" min="1" max="12" value="4"></label>
  </div>
  <div class="ctrls">
    <button id="beginBtn">Begin</button>
    <button id="pauseBtn" hidden>Pause</button>
    <button id="resetBtn" hidden>Reset</button>
  </div>
  <div class="vis">
    <button class="visbtn on" data-vis="hover">Show on hover</button>
    <button class="visbtn" data-vis="always">Always</button>
    <button class="visbtn" data-vis="flash">Flash / min</button>
  </div>
</div>

<div id="ui" class="hidden">
  <button id="lockToggle">▸ Locked — DAY plate (all params)</button>

  <h3>Session</h3>
  <label>Live clock <b id="vLive">0</b></label>
  <input type="range" id="live" min="0" max="1" step="1" value="0">
  <label>Day time <b id="vDaytime">12:00</b></label>
  <input type="range" id="daytime" min="0" max="23.99" step="0.0166666" value="12">
  <div class="lockgrp hid">
  <label>Progress (debug) <b id="vProg">0.35</b></label>
  <input type="range" id="prog" min="0" max="1" step="0.0005" value="0.35">
  <p class="hint" style="margin-top:12px"><b>SAND.</b> Bottom pile is graded like the
    top one — no light/shadow split; its colour follows the time of day. Cone lift is
    what separates the raised pile from the flat bed behind it.</p>
  <label>Cone lift over bed <b id="vConeLift">-0.040</b></label>
  <input type="range" id="coneLift" min="-0.15" max="0.25" step="0.005" value="-0.040">
  <label>Cone apex shadow <b id="vConeTopShd">0.085</b></label>
  <input type="range" id="coneTopShd" min="-0.10" max="0.40" step="0.005" value="0.085">
  <label>Cone base / bed contact <b id="vConeBotShd">0.180</b></label>
  <input type="range" id="coneBotShd" min="-0.10" max="0.40" step="0.005" value="0.180">
  <label>Bed — night <b id="vBedNight">-0.400</b></label>
  <input type="range" id="bedNight" min="-0.60" max="0.15" step="0.005" value="-0.400">
  <label>Bed — midday <b id="vBedDay">-0.300</b></label>
  <input type="range" id="bedDay" min="-0.60" max="0.15" step="0.005" value="-0.300">
  <label>Rim off — top cap <b id="vRimCapT">0.04</b></label>
  <input type="range" id="rimCapT" min="0" max="0.40" step="0.005" value="0.04">
  <label>Rim off — base <b id="vRimCapB">0.04</b></label>
  <input type="range" id="rimCapB" min="0" max="0.40" step="0.005" value="0.04">
  <p class="hint"><b>FALLING SAND.</b> Ported from the app
    (lib/hourglass/hourglass_painter.dart) — accelerating grains, same constants.
    Defaults ARE the app's values.</p>
  <label>Grain count <b id="vStreamN">220</b></label>
  <input type="range" id="streamN" min="10" max="600" step="1" value="220">
  <label>Column width <b id="vStreamCol">1.00</b></label>
  <input type="range" id="streamCol" min="0.3" max="4" step="0.05" value="1.00">
  <label>Fall period (s) <b id="vStreamPer">0.82</b></label>
  <input type="range" id="streamPer" min="0.15" max="1.6" step="0.01" value="0.82">
  <label>Exit speed <b id="vStreamV0">0.30</b></label>
  <input type="range" id="streamV0" min="0" max="0.6" step="0.01" value="0.30">
  <label>Grain size <b id="vStreamSize">1.20</b></label>
  <input type="range" id="streamSize" min="0.3" max="3" step="0.05" value="1.20">
  <label>Grain opacity <b id="vStreamA">1.00</b></label>
  <input type="range" id="streamA" min="0" max="1" step="0.02" value="1.00">
  <label>Grain brightness <b id="vStreamLit">0.020</b></label>
  <input type="range" id="streamLit" min="-0.25" max="0.35" step="0.005" value="0.020">
  <label>Impact scatter <b id="vStreamScat">0.60</b></label>
  <input type="range" id="streamScat" min="0" max="3" step="0.05" value="0.60">
  <label>Land into pile (px) <b id="vStreamLand">0.0</b></label>
  <input type="range" id="streamLand" min="-2" max="8" step="0.5" value="0.0">
  </div><!-- /lockgrp -->
  <div class="lockgrp hid">
  <p class="hint"><b>PILE GATHERING.</b> The sand spreads evenly first, then a pile
    starts small and builds. Start = when the mound begins, Ramp = how much more
    drain until it is the full solved cone.</p>
  <label>Pile starts at <b id="vPileStart">0.00</b></label>
  <input type="range" id="pileStart" min="0" max="0.6" step="0.005" value="0.00">
  <label>Pile ramp <b id="vPileRamp">0.25</b></label>
  <input type="range" id="pileRamp" min="0.005" max="0.8" step="0.005" value="0.25">
  <label>Early spread nudge <b id="vBedEarly">0.000</b></label>
  <input type="range" id="bedEarly" min="-0.20" max="0.30" step="0.005" value="0.000">
  <label>Colour settles over <b id="vBedTint">0.25</b></label>
  <input type="range" id="bedTint" min="0.02" max="1" step="0.01" value="0.25">
  <label>Bed level handover <b id="vBedHand">0.60</b></label>
  <input type="range" id="bedHand" min="0.05" max="1" step="0.01" value="0.60">
  <label>Top final dump at <b id="vTopHold">0.800</b></label>
  <input type="range" id="topHold" min="0.80" max="0.999" step="0.005" value="0.800">
  <label>...having shown only <b id="vTopShown">0.995</b></label>
  <input type="range" id="topShown" min="0.50" max="0.999" step="0.005" value="0.995">
  <label>Stream thins from <b id="vStreamThin">0.97</b></label>
  <input type="range" id="streamThin" min="0.50" max="0.99" step="0.01" value="0.97">
  <label>...down to <b id="vStreamThinTo">0.20</b></label>
  <input type="range" id="streamThinTo" min="0.02" max="1" step="0.02" value="0.20">
  <p class="hint">Copy tuned stream back to me:
    <textarea id="streamOut" readonly rows="2"></textarea></p>


  </div><!-- /lockgrp -->
  <label>Trace horizon line <b id="vHorEdit">0</b></label>
  <input type="range" id="horEdit" min="0" max="1" step="1" value="0">
  <p class="hint">Horizon Y = <b id="vHorVal">0.4475</b> — send me this number to bake it.</p>
  <label>Place sun/moon <b id="vCelEdit">0</b></label>
  <input type="range" id="celEdit" min="0" max="1" step="1" value="0">
  <div class="lockgrp hid">
  <p class="hint" style="margin-top:14px"><b>SUN — edit one key at a time.</b>
    The rendered sun blends between these three by the sun's height, so whatever you
    set here is what shows at that time of day. Scrub Day time to preview.</p>
  <label>Sun key <b id="vSunKey">sunrise</b></label>
  <input type="range" id="sunKey" min="0" max="2" step="1" value="0">
  <label>Sun size <b id="vSunSize">0.020</b></label>
  <input type="range" id="sunSize" min="0.004" max="0.09" step="0.001" value="0.020">
  <label>Core size <b id="vCoreW">2.00</b></label>
  <input type="range" id="coreW" min="0.3" max="8" step="0.05" value="2.00">
  <label>Core strength <b id="vCoreA">2.40</b></label>
  <input type="range" id="coreA" min="0.2" max="6" step="0.05" value="2.40">
  <label>Sun glow size <b id="vNearW">0.38</b></label>
  <input type="range" id="nearW" min="0.05" max="3" step="0.01" value="0.38">
  <label>Sun glow strength <b id="vNearA">1.15</b></label>
  <input type="range" id="nearA" min="0" max="4" step="0.05" value="1.15">
  <label>Far glow size <b id="vFarW">0.07</b></label>
  <input type="range" id="farW" min="0.01" max="1.5" step="0.005" value="0.07">
  <label>Far glow strength <b id="vFarA">0.30</b></label>
  <input type="range" id="farA" min="0" max="2" step="0.02" value="0.30">
  <label>Core colour <input type="color" id="coreCol" value="#fffffa"></label>
  <label>Sun glow colour <input type="color" id="nearCol" value="#ffd170"></label>
  <label>Far glow colour <input type="color" id="farCol" value="#ffae42"></label>
  <p class="hint">Copy tuned keys back to me:
    <textarea id="sunOut" readonly rows="3"></textarea></p>

  <p class="hint" style="margin-top:14px"><b>MOON — all parameters.</b>
    Painted disc (plates/moon-tex.png) plus a shader halo and sky spill.
    Rises 21:45, sets 05:30.</p>
  <label>Moon size <b id="vMoonR">0.040</b></label>
  <input type="range" id="moonR" min="0.01" max="0.16" step="0.001" value="0.040">
  <label>Moon brightness <b id="vMoonK">1.20</b></label>
  <input type="range" id="moonK" min="0" max="2" step="0.01" value="1.20">
  <label>Edge softness <b id="vMoonSoft">0.07</b></label>
  <input type="range" id="moonSoft" min="0.01" max="0.80" step="0.01" value="0.07">
  <label>Halo size <b id="vMoonGlowW">1.30</b></label>
  <input type="range" id="moonGlowW" min="0.1" max="6" step="0.05" value="1.30">
  <label>Halo strength <b id="vMoonGlowA">1.50</b></label>
  <input type="range" id="moonGlowA" min="0" max="4" step="0.05" value="1.50">
  <label>Sky spill size <b id="vMoonFarW">0.540</b></label>
  <input type="range" id="moonFarW" min="0.01" max="1.5" step="0.005" value="0.540">
  <label>Sky spill strength <b id="vMoonFarA">0.16</b></label>
  <input type="range" id="moonFarA" min="0" max="2" step="0.02" value="0.16">
  <label>Surface detail <b id="vMoonTexAmt">0.50</b></label>
  <input type="range" id="moonTexAmt" min="0" max="1" step="0.02" value="0.50">
  <label>Low-moon warmth <b id="vMoonWarm">0.55</b></label>
  <input type="range" id="moonWarm" min="0" max="1" step="0.02" value="0.55">
  <label>Low-moon haze <b id="vMoonHaze">0.30</b></label>
  <input type="range" id="moonHaze" min="0" max="1" step="0.02" value="0.30">
  <label>Fades out by height <b id="vMoonWarmH">0.35</b></label>
  <input type="range" id="moonWarmH" min="0.05" max="1" step="0.01" value="0.35">
  <label>Low-moon tint <input type="color" id="moonWarmCol" value="#ffb877"></label>
  <label>Disc tint <input type="color" id="moonCol" value="#ffffff"></label>
  <label>Halo colour <input type="color" id="moonGlowCol" value="#cfe4ff"></label>
  <label>Sky spill colour <input type="color" id="moonFarCol" value="#6f8fd0"></label>
  <p class="hint">Copy tuned moon back to me:
    <textarea id="moonOut" readonly rows="3"></textarea></p>
  </div><!-- /lockgrp -->
  <p class="hint">Place=1, then drag the sun/moon in the sky — it edits the phase
    you're viewing (scrub Day time to reach it). Moon shows today's real phase.
    <textarea id="celOut" readonly rows="2"></textarea></p>
  <button id="celCopy">Copy sun/moon</button>

  <div class="lockgrp hid">
  <h3>Sand light — <span id="phTag">Mid Day</span></h3>
  <label>Edit phase <b id="vPhase">Mid Day</b></label>
  <input type="range" id="phase" min="0" max="5" step="1" value="2">
  <label>Exposure <b id="vTexpo">1.00</b></label>
  <input type="range" id="texpo" min="0" max="1.6" step="0.01" value="1.00">
  <label>Saturation <b id="vTsat">1.00</b></label>
  <input type="range" id="tsat" min="0" max="1.6" step="0.01" value="1.00">
  <label class="clr">Lit light (key) <input type="color" id="tlit" value="#ffffff"></label>
  <label class="clr">Shadow light (sky) <input type="color" id="tshd" value="#ffffff"></label>
  <p class="hint">These edit the <b>selected</b> Time-of-day phase. Mid Day is the
    anchor (identity). <textarea id="phOut" readonly rows="3"></textarea></p>
  <button id="phCopy">Copy all 6 phase grades</button>
  <p class="hint">The <b>Rim light</b> (in Glass optics, locked) auto-scales per
    phase — strong at night, dim by day — so the hourglass stays the hero.</p>
  </div><!-- /lockgrp: sand light -->

  <div class="lockgrp hid">
  <h3>Scene (bare-glass experiment — rejected)</h3>
  <label>Draw coded glass <b id="vGlassOn">0</b></label>
  <input type="range" id="glassOn" min="0" max="1" step="1" value="0">
  <label>Refraction <b id="vRefr">0.35</b></label>
  <input type="range" id="refr" min="0" max="1.5" step="0.01" value="0.35">
  <label>Glass tint (rim absorption) <b id="vGtint">1.00</b></label>
  <input type="range" id="gtint" min="0" max="2" step="0.02" value="1.00">
  <label>Fresnel rim <b id="vFres">0.60</b></label>
  <input type="range" id="fres" min="0" max="2" step="0.02" value="0.60">
  <label>Glass texture <b id="vGtex">0.15</b></label>
  <input type="range" id="gtex" min="0" max="1" step="0.01" value="0.15">
  <label>Glass wall opacity <b id="vGEdge">0.90</b></label>
  <input type="range" id="gEdge" min="0" max="1.5" step="0.02" value="0.90">
  <label>Glass wall width <b id="vGEdgeW">2.2</b></label>
  <input type="range" id="gEdgeW" min="0.5" max="8" step="0.1" value="2.2">

  <h3>Glass fit — frame (position &amp; size)</h3>
  <label>Center X <b id="vCx">0.498850</b></label>
  <input type="range" id="cx" min="0.49" max="0.51" step="0.000005" value="0.498850">
  <label>Top Y <b id="vTop">0.347</b></label>
  <input type="range" id="top" min="0.25" max="0.45" step="0.001" value="0.347">
  <label>Neck Y <b id="vNeck">0.627</b></label>
  <input type="range" id="neck" min="0.55" max="0.70" step="0.001" value="0.627">
  <label>Bottom Y <b id="vBot">0.888</b></label>
  <input type="range" id="bot" min="0.75" max="0.92" step="0.001" value="0.888">
  <label>Max half <b id="vMax">0.065</b></label>
  <input type="range" id="max" min="0.04" max="0.15" step="0.001" value="0.065">
  <label>Neck half <b id="vNh">0.003</b></label>
  <input type="range" id="nh" min="0" max="0.02" step="0.0005" value="0.003">
  <label>Show glass edge <b id="vDbg">0</b></label>
  <input type="range" id="dbg" min="0" max="1" step="1" value="0">

  <h3>Curve — top bulb</h3>
  <label>Rim corner <b id="vRimK">0.79</b></label>
  <input type="range" id="rimK" min="0.2" max="1.2" step="0.01" value="0.79">
  <label>Widest Y <b id="vWTop">0.370</b></label>
  <input type="range" id="wTop" min="0.20" max="0.60" step="0.005" value="0.370">
  <label>Upper fullness <b id="vATop">0.075</b></label>
  <input type="range" id="aTop" min="0.02" max="0.45" step="0.005" value="0.075">
  <label>Lower fullness <b id="vBTop">0.345</b></label>
  <input type="range" id="bTop" min="0.05" max="0.48" step="0.005" value="0.345">
  <label>Neck approach <b id="vCTop">0.080</b></label>
  <input type="range" id="cTop" min="0.02" max="0.40" step="0.005" value="0.080">

  <h3>Curve — bottom bulb</h3>
  <label>Width scale <b id="vMxBot">0.985</b></label>
  <input type="range" id="mxBot" min="0.80" max="1.20" step="0.005" value="0.985">
  <label>Widest Y <b id="vWBot">0.700</b></label>
  <input type="range" id="wBot" min="0.40" max="0.85" step="0.005" value="0.700">
  <label>Neck exit <b id="vABot">0.150</b></label>
  <input type="range" id="aBot" min="0.02" max="0.45" step="0.005" value="0.150">
  <label>Upper fullness <b id="vBBot">0.375</b></label>
  <input type="range" id="bBot" min="0.05" max="0.48" step="0.005" value="0.375">
  <label>Lower fullness <b id="vCBot">0.110</b></label>
  <input type="range" id="cBot" min="0.02" max="0.40" step="0.005" value="0.110">
  <label>Base corner <b id="vBaseK">0.91</b></label>
  <input type="range" id="baseK" min="0.2" max="1.2" step="0.01" value="0.91">

  <h3>Curve — ends (under the caps)</h3>
  <label>Top rim width <b id="vTopW">0.000</b></label>
  <input type="range" id="topW" min="0" max="0.05" step="0.001" value="0.000">
  <label>Base width <b id="vBotW">0.000</b></label>
  <input type="range" id="botW" min="0" max="0.05" step="0.001" value="0.000">

  <h3>Outline nodes — drag on canvas</h3>
  <p class="hint" id="curveState">LOCKED — 100% outline</p>
  <p class="hint">Set <b>Show glass edge = 1</b>, then drag the <b>white dots</b>
    (anchors) or <b>blue dots</b> (curve handles) — on <b>either</b> side; the two
    halves stay mirrored. Drag anywhere <b>off</b> a point to move the whole
    hourglass. 7 nodes per side: 5 around the top, 5 around the bottom, 1 neck.
    <kbd>R</kbd> restores the locked outline · <kbd>Shift</kbd>+<kbd>R</kbd> reverts
    to slider-driven.</p>
  <textarea id="nodeOut" readonly rows="4"></textarea>
  <button id="copyNodes">Copy node data</button>
  </div><!-- /lockgrp -->

  <div class="lockgrp hid">
  <h3>Sand — shape &amp; style</h3>
  <label>Anime flatness <b id="vFlat">0.20</b></label>
  <input type="range" id="flat" min="0" max="1" step="0.02" value="0.20">
  <label>Pile top-view (ellipse) <b id="vPersp">0.090</b></label>
  <input type="range" id="persp" min="0" max="0.40" step="0.005" value="0.090">
  <label>Sand amount <b id="vSandVol">0.75</b></label>
  <input type="range" id="sandVol" min="0.20" max="1.00" step="0.01" value="0.75">
  <label>Pile angle <b id="vRepose">0.545</b></label>
  <input type="range" id="repose" min="0.25" max="1.00" step="0.005" value="0.545">
  <label>Pile apex round <b id="vApexR">0.07</b></label>
  <input type="range" id="apexR" min="0" max="0.50" step="0.01" value="0.07">
  <label>Top sand bulge <b id="vTopBulge">0.30</b></label>
  <input type="range" id="topBulge" min="0" max="1" step="0.02" value="0.30">
  <label>Crook — top (minute) <b id="vCrookT">0.0010</b></label>
  <input type="range" id="crookT" min="0" max="0.020" step="0.0005" value="0.0010">
  <label>Crook — bottom pile <b id="vCrookB">0.015</b></label>
  <input type="range" id="crookB" min="0" max="0.060" step="0.001" value="0.015">
  <label>Crook frequency <b id="vCrookF">26</b></label>
  <input type="range" id="crookF" min="2" max="30" step="1" value="26">

  <h3>Sand colour — TOP (shadowed)</h3>
  <label>Hue <b id="vShueT">30</b></label>
  <input type="range" id="shueT" min="15" max="60" step="1" value="30">
  <label>Saturation <b id="vSsatT">34</b></label>
  <input type="range" id="ssatT" min="5" max="85" step="1" value="34">
  <label>Lightness <b id="vSlitT">0.52</b></label>
  <input type="range" id="slitT" min="0.35" max="0.92" step="0.01" value="0.52">
  <label>Lit edge <b id="vLitT">0.000</b></label>
  <input type="range" id="litT" min="0" max="0.30" step="0.005" value="0.000">
  <label>Shadow depth <b id="vShdT">0.000</b></label>
  <input type="range" id="shdT" min="0" max="0.40" step="0.005" value="0.000">

  <h3>Sand colour — BOTTOM (half lit)</h3>
  <label>Hue <b id="vShueB">30</b></label>
  <input type="range" id="shueB" min="15" max="60" step="1" value="30">
  <label>Saturation <b id="vSsatB">34</b></label>
  <input type="range" id="ssatB" min="5" max="85" step="1" value="34">
  <label>Lightness <b id="vSlitB">0.65</b></label>
  <input type="range" id="slitB" min="0.35" max="0.92" step="0.01" value="0.65">
