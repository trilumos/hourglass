---
// LANDING — a PINNED story, not a scrolling page (founder, 2026-08-02).
//
// Nothing on the page moves. The scene, its bottom tint, the grain and the nav are CONSTANT the whole way
// down ("like a ppt with the same background throughout, only text is changing"). Scrolling only cross-fades
// text and advances the day. The centre column (hourglass) is never covered.
//
// Each chapter is one statement and at most THREE short points, never paragraphs. The heading sits on one
// flank, the points on the other, both on the SAME vertical line, sides swapping each chapter. The points
// ride a quiet glass plate because they are small type over painted art; the heading needs none.
//
// Design laws (impeccable + ui-ux-pro-max): glass is rare and purposeful, not decorative; no identical card
// grids; crossfade for content replacement in one container; ease-out entry, faster exit; reduced-motion
// honoured; no em dashes in copy.

const PLAY = 'https://play.google.com/store/apps/details?id=com.trilumos.sustain';

// FAQ: what is visible IS what is in the structured data (Google requires the two to match), so three.
const FAQ = [
  { q: 'Is it free?',
    a: 'Yes, forever. Every mode, the whole living world, no account and no ads.' },
  { q: 'Does the timer survive a background tab?',
    a: 'Yes. It reads the wall clock instead of counting frames, so a throttled tab cannot make it drift.' },
  { q: 'Why does the sky change while I work?',
    a: 'It follows your real day. Sustain reads your timezone and moves the sun and moon to match.' },
];

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: FAQ.map(f => ({
    '@type': 'Question', name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const CHAPTERS = 6;   // hero (0) + five
// Viewports of scroll per chapter. Short on purpose: `scroll-snap-stop: always` guarantees each chapter is
// a stop no matter how hard you flick, so this only sets how FAR you must drag to trip the next one. The
// snap fires past the halfway mark, so 0.75 means roughly a third of a screen of scroll per chapter.
// Single source of truth: the controller in index.astro reads it off #runway's data attribute.
const CH_LEN = 0.75;
---

<div class="chapters" id="chapters">

  <!-- ═══ 1 · How it works — heading RIGHT ═══ -->
  <article class="ch flip" id="how-it-works" aria-labelledby="hiw-h">
    <div class="say">
      <p class="eyebrow">How it works</p>
      <h2 id="hiw-h" style="--n:18"><span>Focus is a ritual,</span><span>not a countdown.</span></h2>
      <p class="lead">Four modes. One rhythm.</p>
    </div>
    <div class="tell">
      <ul class="points">
        <li>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 3h10M7 21h10M8 3v3.2a4 4 0 0 0 1.6 3.2L12 12l2.4-2.6A4 4 0 0 0 16 6.2V3M8 21v-3.2a4 4 0 0 1 1.6-3.2L12 12l2.4 2.6a4 4 0 0 1 1.6 3.2V21"/></svg>
          <b>Choose a block</b><span>Flow, Pomodoro, Custom or Endless.</span>
        </li>
        <li>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 20.5 15.2 9.3a2.6 2.6 0 1 0-3.7-3.7L4 13.2v7.3ZM13.4 7.4l3.7 3.7"/></svg>
          <b>Name the intention</b><span>One line, kept in sight while you work.</span>
        </li>
        <li>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21c-4.4 0-8-3.6-8-8 0-5.5 5-9 13-9 0 8-3.5 13-9 13-2.2 0-4-.8-4-.8"/><path d="M6 21c1.5-5 5-8.5 9-10.5"/></svg>
          <b>Recover properly</b><span>The break is training, not a reward.</span>
        </li>
      </ul>
    </div>
  </article>

  <!-- ═══ 2 · The living world — heading LEFT ═══ -->
  <article class="ch" id="living-world" aria-labelledby="lw-h">
    <div class="say">
      <p class="eyebrow">The living world</p>
      <h2 id="lw-h" style="--n:14"><span>The sky moves</span><span>with your day.</span></h2>
      <p class="lead">Your real sunrise. Your real sunset.</p>
    </div>
    <div class="tell">
      <ul class="points">
        <li>
          <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2.5M12 19.5V22M2 12h2.5M19.5 12H22M4.9 4.9l1.8 1.8M17.3 17.3l1.8 1.8M19.1 4.9l-1.8 1.8M6.7 17.3l-1.8 1.8"/></svg>
          <b>Six painted skies</b><span>Cross-fading from pre-dawn to midnight.</span>
        </li>
        <li>
          <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.5 2.6 2.5 15.4 0 18M12 3c-2.5 2.6-2.5 15.4 0 18"/></svg>
          <b>Local to you</b><span>Sun times worked out from your timezone.</span>
        </li>
        <li>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 17c2.5 0 2.5-2 5-2s2.5 2 5 2 2.5-2 5-2 2.5 2 3 2M3 11c2.5 0 2.5-2 5-2s2.5 2 5 2 2.5-2 5-2 2.5 2 3 2"/></svg>
          <b>The sand is your session</b><span>Falling live. Frozen the moment you pause.</span>
        </li>
      </ul>
    </div>
  </article>

  <!-- ═══ 3 · Why it works — heading RIGHT ═══ -->
  <article class="ch flip" id="science" aria-labelledby="sci-h">
    <div class="say">
      <p class="eyebrow">Why it works</p>
      <h2 id="sci-h" style="--n:11"><span>Blocks beat</span><span>willpower.</span></h2>
      <p class="lead">Three findings, built in.</p>
    </div>
    <div class="tell">
      <ul class="points">
        <li>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h9M4 12h6M4 17h9"/><path d="M15 5l5 5-5 5"/></svg>
          <b>Switching costs you</b><span>Attention stays on the task you left.<i>Leroy, 2009</i></span>
        </li>
        <li>
          <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="8.5"/><path d="M12 7v5.4l3.4 2"/></svg>
          <b>Train in bouts</b><span>The best rest deliberately between.<i>Ericsson, 1993</i></span>
        </li>
        <li>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2 14c2.6 0 2.6-6 5.2-6s2.6 6 5.2 6 2.6-6 5.2-6S20.2 14 22 14"/></svg>
          <b>Ride the wave</b><span>Alertness moves in ninety-minute swells.<i>Kleitman, 1982</i></span>
        </li>
